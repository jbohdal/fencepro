# ── Database ──
DATABASE_URL="postgresql://fencepro:fencepro@localhost:5432/fencepro_portal?schema=public"

# ── Auth ──
JWT_SECRET="change-me-to-a-random-64-char-string"
JWT_REFRESH_SECRET="change-me-to-another-random-64-char-string"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ── CRM Integration ──
CRM_PROVIDER="fencepro"          # fencepro | hubspot | salesforce | zoho
CRM_BASE_URL="http://localhost:3000/api"
CRM_API_KEY=""

# ── File Storage ──
STORAGE_DRIVER="local"           # local | s3
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=25
# S3 (if STORAGE_DRIVER=s3)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ── Email (password reset) ──
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@fencepro.com"

# ── App ──
PORT=4000
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"

# ── Rate Limiting ──
RATE_LIMIT_LOGIN="5/15m"
RATE_LIMIT_UPLOAD="10/1h"
RATE_LIMIT_API="100/1m"

# ── Google Calendar (appointment sync) ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/google-calendar/callback"

# ── Redis (optional, for caching) ──
REDIS_URL=""
