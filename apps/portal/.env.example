# ── Database ──
DATABASE_URL="postgresql://fencepro:fencepro@localhost:5432/fencepro_portal?schema=public"

# ── Auth ──
JWT_SECRET="change-me-to-a-random-64-char-string"
JWT_REFRESH_SECRET="change-me-to-another-random-64-char-string"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ── CRM Integration ──
CRM_PROVIDER="fencepro"          # fencepro | hubspot | salesforce | zoho
CRM_BASE_URL="http://localhost:3000/api"
CRM_API_KEY=""

# ── File Storage ──
STORAGE_DRIVER="local"           # local | s3
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=25
# S3 (if STORAGE_DRIVER=s3)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ── Email (password reset) ──
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@fencepro.com"

# ── App ──
PORT=4000
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"

# ── Rate Limiting ──
# Plain numbers. Leave unset to use the defaults shown.
# RATE_LIMIT_LOGIN_FAILS_PER_15MIN=10
# RATE_LIMIT_UPLOADS_PER_HOUR=60
# RATE_LIMIT_API_PER_MIN=600

# ── Google Calendar (appointment sync) ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/google-calendar/callback"

# ── Redis (optional, for caching) ──
REDIS_URL=""

# ── Website quote widget (EZ Quote) ──
# Any long random string. Put the same value in the widget as
# NEXT_PUBLIC_CRM_WIDGET_TOKEN. Leave unset to keep website intake off.
# EZ_QUOTE_WIDGET_TOKEN=
# Where the widget is hosted (comma separated, no trailing slash).
# EZ_QUOTE_ALLOWED_ORIGINS=https://quote.gdfencepro.com,https://gdfencepro.com

# ── Phone agent (Retell) ──
# The Retell API key that has the webhook badge. It is used to check that a
# webhook really came from Retell. Leave unset to keep phone intake off.
# Webhook URL to give Retell: https://YOUR-DOMAIN/api/intake/retell
# RETELL_API_KEY=

# Only needed if this database holds more than one company.
# INTAKE_ACCOUNT_ID=
