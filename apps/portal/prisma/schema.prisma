generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──

enum Role {
  customer
  admin
  support_agent
}

enum TicketStatus {
  open
  in_progress
  waiting_customer
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

enum InvoiceStatus {
  pending
  paid
  overdue
  cancelled
  refunded
}

enum AccountStatus {
  active
  suspended
  cancelled
}

// ── Models ──

model Customer {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  role          Role      @default(customer)
  accountId     String
  portalEnabled Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  account       CrmAccount         @relation(fields: [accountId], references: [id])
  documents     Document[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  chats         ChatConversation[]

  @@index([accountId])
  @@index([email])
}

model CrmAccount {
  id               String        @id @default(uuid())
  externalCrmId    String?       @unique
  name             String
  status           AccountStatus @default(active)
  assignedRepName  String?
  assignedRepEmail String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  customers        Customer[]
  documents        Document[]
  tickets          Ticket[]
  invoices         Invoice[]
  contracts        Contract[]
  staffUsers       CrmUser[]          @relation("StaffOfCrmAccount")
  contacts         CrmContact[]       @relation("ContactsOfCrmAccount")
  savedQuotes      SavedQuote[]       @relation("QuotesOfCrmAccount")
  savedJobs        SavedJob[]         @relation("JobsOfCrmAccount")
  scheduleSettings ScheduleSettings?
  scheduleEntries  ScheduledGridJob[]
  rainDayLogs      ScheduleRainDay[]
  pipelineState    PipelineState?
  inventoryState   InventoryState?
  vendorState      VendorState?
  businessState    BusinessState?

  @@index([externalCrmId])
}

model Document {
  id             String    @id @default(uuid())
  customerId     String
  accountId      String
  filename       String
  originalName   String
  storagePath    String
  mimeType       String
  sizeBytes      Int
  linkedEntity   String? // 'ticket', 'contract', 'invoice'
  linkedEntityId String?
  uploadedAt     DateTime  @default(now())
  deletedAt      DateTime?

  customer Customer   @relation(fields: [customerId], references: [id])
  account  CrmAccount @relation(fields: [accountId], references: [id])

  @@index([customerId])
  @@index([accountId])
  @@index([linkedEntity, linkedEntityId])
}

model Ticket {
  id            String         @id @default(uuid())
  externalCrmId String?        @unique
  accountId     String
  title         String
  description   String?
  status        TicketStatus   @default(open)
  priority      TicketPriority @default(medium)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  account  CrmAccount      @relation(fields: [accountId], references: [id])
  comments TicketComment[]

  @@index([accountId])
  @@index([status])
}

model TicketComment {
  id         String   @id @default(uuid())
  ticketId   String
  authorName String
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Invoice {
  id            String        @id @default(uuid())
  externalCrmId String?       @unique
  accountId     String
  invoiceNumber String
  amountCents   Int
  currency      String        @default("USD")
  dueDate       DateTime
  paidAt        DateTime?
  status        InvoiceStatus @default(pending)
  pdfPath       String?
  createdAt     DateTime      @default(now())

  account CrmAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([status])
}

model Contract {
  id            String    @id @default(uuid())
  externalCrmId String?   @unique
  accountId     String
  name          String
  description   String?
  startDate     DateTime
  endDate       DateTime?
  status        String    @default("active") // active, expired, cancelled
  createdAt     DateTime  @default(now())

  account CrmAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
}

model AuditLog {
  id         String   @id @default(uuid())
  customerId String?
  action     String // login, logout, upload, download, ticket_create, ticket_reply, etc.
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([action])
  @@index([createdAt])
}

model RefreshToken {
  id         String   @id @default(uuid())
  customerId String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([customerId])
}

// ── Chat ──

enum ChatStatus {
  active
  resolved
  escalated
}

model ChatConversation {
  id         String     @id @default(uuid())
  customerId String
  accountId  String
  status     ChatStatus @default(active)
  summary    String?
  ticketId   String? // set when escalated to a ticket
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  customer Customer      @relation(fields: [customerId], references: [id])
  messages ChatMessage[]

  @@index([customerId])
  @@index([accountId])
  @@index([status])
}

model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String // 'customer', 'assistant', 'agent'
  body           String
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ── Lead Generation (Botpress chatbot → backend) ──

enum LeadStage {
  new_lead
  qualified
  appointment_scheduled
  contacted
  proposal_sent
  won
  lost
}

enum LeadUrgency {
  asap
  one_to_three_months
  three_to_six_months
  just_looking
}

enum FollowUpStatus {
  pending
  sent
  failed
  cancelled
}

model Lead {
  id                     String       @id @default(uuid())
  // Contact info
  firstName              String?
  lastName               String?
  email                  String?
  phone                  String?
  address                String?
  city                   String?
  state                  String?
  zipCode                String?
  // Project details
  fenceType              String? // vinyl, aluminum, wood, chain_link, etc.
  linearFootage          Int?
  propertyType           String? // residential, commercial
  timeline               LeadUrgency?
  budgetMin              Int? // cents
  budgetMax              Int? // cents
  notes                  String?
  // Qualification
  stage                  LeadStage    @default(new_lead)
  score                  Int          @default(0) // 0-100
  scoringDetails         Json? // breakdown of how score was calculated
  tags                   String[]     @default([])
  // Botpress
  botpressConversationId String?      @unique
  transcript             Json? // full chat transcript from Botpress
  // Assignment
  assignedRepName        String?
  assignedRepEmail       String?
  // Lifecycle
  source                 String       @default("website_chat")
  convertedAt            DateTime?
  lostReason             String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  appointments Appointment[]
  followUps    FollowUp[]

  @@index([stage])
  @@index([email])
  @@index([zipCode])
  @@index([score])
  @@index([createdAt])
}

model Appointment {
  id                    String    @id @default(uuid())
  leadId                String
  scheduledAt           DateTime
  duration              Int       @default(60) // minutes
  type                  String    @default("estimate") // estimate, follow_up, consultation
  location              String? // address for the estimate visit
  notes                 String?
  confirmed             Boolean   @default(false)
  cancelledAt           DateTime?
  completedAt           DateTime?
  reminderSent          Boolean   @default(false)
  // Google Calendar sync
  googleCalendarEventId String? // GCal event ID for sync
  assignedRepEmail      String? // salesman's email whose calendar gets the event
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([scheduledAt])
}

// ── Google Calendar OAuth Tokens ──

model GoogleCalendarToken {
  id           String   @id @default(uuid())
  email        String   @unique // the Google account email
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

model FollowUp {
  id           String         @id @default(uuid())
  leadId       String
  type         String // sms, email
  channel      String         @default("sms") // sms, email
  message      String
  scheduledFor DateTime
  sentAt       DateTime?
  status       FollowUpStatus @default(pending)
  errorMessage String?
  createdAt    DateTime       @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([status, scheduledFor])
}

model PricingRule {
  id          String   @id @default(uuid())
  fenceType   String   @unique
  displayName String
  minPerFoot  Int // cents per linear foot (low end)
  maxPerFoot  Int // cents per linear foot (high end)
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Chatbot Knowledge Base ──

model KnowledgeEntry {
  id        String   @id @default(uuid())
  category  String // faq, policy, materials, process, warranty, financing, etc.
  title     String
  content   String // the actual knowledge — markdown supported
  keywords  String[] @default([]) // help the bot match relevant entries
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([active])
}

// ── EZ Budget — Instant Quoting Module ──

enum EzBudgetQuoteStatus {
  draft
  sent
  viewed
  accepted
  declined
  expired
}

model EzBudgetService {
  id             String   @id @default(uuid())
  name           String
  description    String?
  category       String? // grouping label (e.g., "Vinyl", "Chain Link")
  unitLabel      String   @default("per linear foot") // display unit
  basePriceCents Int // default price in cents
  minQty         Int? // optional minimum quantity
  maxQty         Int? // optional maximum quantity
  imageUrl       String?
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  metadata       Json? // flexible extra fields
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lineItems EzBudgetLineItem[]

  @@index([active])
  @@index([category])
}

model EzBudgetQuote {
  id              String              @id @default(uuid())
  quoteNumber     String              @unique @default(uuid())
  status          EzBudgetQuoteStatus @default(draft)
  // Customer info (captured by widget)
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  customerAddress String?
  customerCity    String?
  customerState   String?
  customerZip     String?
  // Totals
  subtotalCents   Int                 @default(0)
  discountCents   Int                 @default(0)
  taxCents        Int                 @default(0)
  totalCents      Int                 @default(0)
  // Fence map data
  mapData         Json? // { coordinates, fenceLine, runs, layout, gateConfig }
  material        String? // vinyl, aluminum, etc.
  style           String? // vinyl-full-privacy, etc.
  height          String? // 4ft, 5ft, 6ft, 8ft
  color           String?
  linearFeet      Float?
  requestOnSite   Boolean             @default(false)
  photos          String[]            @default([])
  // Metadata
  notes           String?
  internalNotes   String?
  source          String              @default("widget") // widget, manual, api
  expiresAt       DateTime?
  viewedAt        DateTime?
  respondedAt     DateTime?
  // Lifecycle
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  lineItems EzBudgetLineItem[]

  @@index([status])
  @@index([customerEmail])
  @@index([createdAt])
}

model EzBudgetLineItem {
  id             String   @id @default(uuid())
  quoteId        String
  serviceId      String?
  label          String // display name (snapshot from service or custom)
  quantity       Float    @default(1)
  unitPriceCents Int
  totalCents     Int
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  quote   EzBudgetQuote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service EzBudgetService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([serviceId])
}

model EzBudgetSettings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Automation Engine ──

enum AutomationTriggerType {
  sales_stage_change
  ops_stage_change
  job_created
  job_assigned
  job_scheduled
  job_rescheduled
  stale_job // no status update for X days
  deadline_approaching // X days before a due date
  form_submitted
  payment_received
  customer_no_response
  rain_day_flagged
  customer_created
  invoice_created
  quote_sold
}

enum AutomationActionType {
  move_ops_stage
  move_sales_stage
  send_email
  send_sms
  send_notification
  create_task
  schedule_reminder
  post_activity_note
  fire_webhook
  require_checklist_gate
}

enum AutomationRunStatus {
  success
  partial
  failed
}

// ── Entity Activity Log (customer / job / deal activity feed) ──

// ── Customer Portal Accounts (CRM-owned) ──

enum PortalAccountStatus {
  invited
  active
  suspended
}

model PortalAccount {
  id                   String              @id @default(uuid())
  crmCustomerId        String // references CRM-side fencepro_customers id (external string)
  email                String              @unique
  firstName            String?
  lastName             String?
  status               PortalAccountStatus @default(invited)
  passwordHash         String?
  mustChangePassword   Boolean             @default(true)
  inviteToken          String?             @unique // SHA-256 hash of the raw token, never the raw
  inviteTokenExpiresAt DateTime?
  invitedAt            DateTime?
  activatedAt          DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  invites PortalInvite[]

  @@index([crmCustomerId])
  @@index([inviteToken])
  @@index([status])
}

enum PortalFileSource {
  portal_customer
  crm_staff
  system_generated
  companycam
}

enum PortalFileKind {
  photo
  document
  site_plan
  contract
  permit
  warranty
  other
}

enum PortalMessageSender {
  customer
  staff
}

model PortalPhoto {
  id                  String           @id @default(uuid())
  crmCustomerId       String
  uploadedByAccountId String? // PortalAccount id when customer-uploaded
  uploadedByUser      String? // staff user identifier when staff-uploaded
  fileKey             String // storage path
  fileUrl             String? // public URL if available
  originalFilename    String
  fileSizeBytes       Int
  mimeType            String
  caption             String?
  source              PortalFileSource @default(portal_customer)
  isVisibleToCustomer Boolean          @default(true)
  createdAt           DateTime         @default(now())
  deletedAt           DateTime?

  @@index([crmCustomerId])
  @@index([source])
}

model PortalFile {
  id                  String           @id @default(uuid())
  crmCustomerId       String
  uploadedByAccountId String?
  uploadedByUser      String?
  fileKey             String
  fileUrl             String?
  originalFilename    String
  fileSizeBytes       Int
  mimeType            String
  fileKind            PortalFileKind   @default(document)
  source              PortalFileSource @default(portal_customer)
  label               String?
  isVisibleToCustomer Boolean          @default(true)
  createdAt           DateTime         @default(now())
  deletedAt           DateTime?

  @@index([crmCustomerId])
  @@index([fileKind])
  @@index([source])
}

model PortalMessage {
  id               String              @id @default(uuid())
  crmCustomerId    String
  senderAccountId  String? // PortalAccount id when from customer
  senderUser       String? // staff user identifier when from staff
  senderType       PortalMessageSender
  body             String              @db.Text
  isReadByStaff    Boolean             @default(false)
  isReadByCustomer Boolean             @default(false)
  readByStaffAt    DateTime?
  readByCustomerAt DateTime?
  createdAt        DateTime            @default(now())
  deletedAt        DateTime?

  @@index([crmCustomerId, createdAt])
  @@index([senderType])
  @@index([isReadByStaff])
}

model PortalInvite {
  id         String    @id @default(uuid())
  accountId  String
  email      String
  sentAt     DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?

  account PortalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([sentAt])
}

// ── Job Checklist (operations milestones) ──

model JobChecklistItem {
  id          String    @id @default(uuid())
  jobId       String
  label       String
  isComplete  Boolean   @default(false)
  completedBy String?
  completedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([jobId])
}

model ActivityLog {
  id         String   @id @default(uuid())
  entityType String // 'customer' | 'job' | 'deal' | 'invoice' | 'quote'
  entityId   String
  actor      String // 'system' | 'automation' | user name
  body       String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

model Automation {
  id            String                @id @default(uuid())
  name          String
  description   String?
  triggerType   AutomationTriggerType
  triggerConfig Json // { fromStage?, toStage?, daysOffset?, stageKey? }
  actions       Json // [{ type, config }] — ordered action array
  conditions    Json? // optional filters: { assignedRep?, fenceType?, businessHoursOnly? }
  isActive      Boolean               @default(true)
  createdBy     String?
  lastFiredAt   DateTime?
  fireCount     Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  runLogs AutomationRunLog[]

  @@index([isActive])
  @@index([triggerType])
}

model AutomationRunLog {
  id              String              @id @default(uuid())
  automationId    String
  automationName  String // snapshot in case automation is later deleted
  jobId           String? // the job that triggered it (localStorage ID or external ref)
  jobName         String? // snapshot: customer name or job label
  triggerType     String
  actionsExecuted Json // [{ type, config, result, error? }]
  status          AutomationRunStatus
  errorMessage    String?
  firedAt         DateTime            @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([jobId])
  @@index([firedAt])
}

// ── Tasks (created by automations or manually) ──

enum TaskStatus {
  pending
  in_progress
  completed
  cancelled
}

enum TaskPriority {
  low
  normal
  high
  urgent
}

model Task {
  id           String       @id @default(uuid())
  title        String
  description  String?
  assignedTo   String? // user name or role
  assignedRole String? // owner, admin, salesman, ops_manager, shop
  jobId        String? // linked job ID
  jobName      String? // snapshot
  status       TaskStatus   @default(pending)
  priority     TaskPriority @default(normal)
  dueDate      DateTime?
  completedAt  DateTime?
  createdBy    String? // "automation:ID" or user name
  automationId String? // if created by automation
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
  @@index([assignedTo])
  @@index([assignedRole])
  @@index([dueDate])
  @@index([jobId])
}

// ── In-App Notifications ──

model Notification {
  id            String    @id @default(uuid())
  recipientId   String? // user name or ID
  recipientRole String? // broadcast to role
  title         String
  body          String
  type          String    @default("info") // info, warning, success, error, automation
  link          String? // deep link within app (e.g., "/jobs/123")
  jobId         String?
  read          Boolean   @default(false)
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([recipientId, read])
  @@index([recipientRole, read])
  @@index([createdAt])
}

// ── Integration Framework ──

enum IntegrationStatus {
  connected
  disconnected
  error
}

model Integration {
  id           String            @id @default(uuid())
  name         String
  slug         String            @unique // twilio, google_calendar, stripe, etc.
  category     String // Communication, Payments, Scheduling, etc.
  description  String?
  logoUrl      String?
  isActive     Boolean           @default(false)
  config       Json? // encrypted credentials + settings
  capabilities String[]          @default([]) // send_sms, sync_calendar, etc.
  connectedBy  String?
  connectedAt  DateTime?
  lastSyncedAt DateTime?
  status       IntegrationStatus @default(disconnected)
  errorLog     String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  activityLogs IntegrationLog[]

  @@index([slug])
  @@index([isActive])
  @@index([category])
}

model IntegrationLog {
  id            String   @id @default(uuid())
  integrationId String
  action        String // connect, disconnect, sync, webhook_in, webhook_out, error
  details       String?
  payload       Json?
  status        String   @default("success") // success, error
  errorMessage  String?
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([createdAt])
}

// ── API Keys ──

model ApiKey {
  id           String    @id @default(uuid())
  name         String
  keyHash      String    @unique // bcrypt hash of the actual key
  keyPrefix    String // first 8 chars for display (e.g., "fp_live_a3b2...")
  scope        String    @default("read") // read, read_write, admin
  createdBy    String
  lastUsedAt   DateTime?
  requestCount Int       @default(0)
  isActive     Boolean   @default(true)
  revokedAt    DateTime?
  revokedBy    String?
  createdAt    DateTime  @default(now())

  usageLogs ApiKeyUsageLog[]

  @@index([keyHash])
  @@index([isActive])
}

model ApiKeyUsageLog {
  id         String   @id @default(uuid())
  apiKeyId   String
  endpoint   String
  method     String
  statusCode Int
  ipAddress  String?
  createdAt  DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([createdAt])
}

// ── Inbound Webhook Log ──

model WebhookInboundLog {
  id           String    @id @default(uuid())
  source       String // stripe, companycam, zapier, etc.
  endpoint     String
  payload      Json?
  headers      Json?
  status       String    @default("received") // received, processed, failed, queued
  errorMessage String?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([source])
  @@index([status])
  @@index([createdAt])
}

// ── CRM Users & Auth ──

enum CrmUserRole {
  super_admin
  admin
  manager
  sales_rep
  field_crew
  office_staff
  customer
}

enum CrmUserStatus {
  active
  invited
  suspended
  deactivated
}

model CrmUser {
  id                   String        @id @default(uuid())
  email                String        @unique
  passwordHash         String?
  firstName            String
  lastName             String
  phone                String?
  avatarUrl            String?
  role                 CrmUserRole   @default(office_staff)
  status               CrmUserStatus @default(invited)
  invitedById          String?
  inviteTokenHash      String?       @unique
  inviteTokenExpiresAt DateTime?
  mustChangePassword   Boolean       @default(true)
  failedLoginAttempts  Int           @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  customerId           String? // for customer portal users
  crmAccountId         String? // company / tenant this staff user belongs to
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  invitedBy   CrmUser?          @relation("UserInvites", fields: [invitedById], references: [id])
  invitees    CrmUser[]         @relation("UserInvites")
  sessions    CrmUserSession[]
  activityLog CrmUserActivity[]
  crmAccount  CrmAccount?       @relation("StaffOfCrmAccount", fields: [crmAccountId], references: [id])

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([inviteTokenHash])
  @@index([crmAccountId])
}

model CrmUserSession {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user CrmUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model CrmUserActivity {
  id         String   @id @default(uuid())
  userId     String
  action     String // login, logout, invite_sent, role_changed, job_created, etc.
  entityType String? // job, quote, customer, user, etc.
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user CrmUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ── Finance: Vendor Management & Accounts Payable ──

enum VendorPaymentTerms {
  net_15
  net_30
  net_45
  net_60
  due_on_receipt
  custom
}

enum VendorBillStatus {
  draft
  received
  approved
  scheduled
  paid
  overdue
  void
}

enum VendorBillCategory {
  materials
  labor
  equipment
  overhead
  subcontractor
  utilities
  insurance
  other
}

enum VendorPaymentMethod {
  check
  ach
  wire
  credit_card
  cash
  other
}

model VendorContact {
  id            String             @id @default(uuid())
  companyId     String? // multi-tenant readiness
  name          String
  contactName   String?
  phone         String?
  email         String?
  address       String?
  city          String?
  state         String?
  zip           String?
  paymentTerms  VendorPaymentTerms @default(net_30)
  accountNumber String?
  notes         String?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  bills    VendorBill[]
  payments VendorPayment[]

  @@index([companyId])
  @@index([isActive])
  @@index([name])
}

model VendorBill {
  id              String               @id @default(uuid())
  vendorId        String
  billNumber      String
  description     String?
  status          VendorBillStatus     @default(received)
  subtotalCents   Int                  @default(0)
  taxCents        Int                  @default(0)
  totalCents      Int                  @default(0)
  amountPaidCents Int                  @default(0)
  balanceDueCents Int                  @default(0)
  billDate        DateTime
  dueDate         DateTime
  paidAt          DateTime?
  paymentMethod   VendorPaymentMethod?
  referenceNumber String?
  category        VendorBillCategory   @default(other)
  jobId           String? // link to a job for job costing
  notes           String?
  createdBy       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  vendor    VendorContact        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  lineItems VendorBillLineItem[]
  payments  VendorPayment[]

  @@index([vendorId])
  @@index([status])
  @@index([category])
  @@index([jobId])
  @@index([billDate])
  @@index([dueDate])
}

model VendorBillLineItem {
  id            String   @id @default(uuid())
  billId        String
  description   String
  quantity      Float    @default(1)
  unitCostCents Int      @default(0)
  totalCents    Int      @default(0)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  bill VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
}

model VendorPayment {
  id              String              @id @default(uuid())
  billId          String
  vendorId        String
  amountCents     Int
  paymentMethod   VendorPaymentMethod
  referenceNumber String?
  paymentDate     DateTime
  recordedBy      String?
  notes           String?
  createdAt       DateTime            @default(now())

  bill   VendorBill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  vendor VendorContact @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@index([vendorId])
  @@index([paymentDate])
}

// ── Finance: Manual P&L Entries ──

enum PlEntryCategory {
  revenue
  cogs
  gross_profit
  operating_expense
  ebitda_adjustment
  depreciation
  amortization
  interest
  tax
  other
}

model PlManualEntry {
  id          String          @id @default(uuid())
  periodMonth Int // 1-12
  periodYear  Int
  category    PlEntryCategory
  label       String
  amountCents Int
  isRecurring Boolean         @default(false)
  notes       String?
  createdBy   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([periodYear, periodMonth])
  @@index([category])
}

// ── Finance: Balance Sheet ──

enum BalanceSheetCategory {
  current_asset
  fixed_asset
  other_asset
  current_liability
  long_term_liability
  equity
}

model BalanceSheetEntry {
  id          String               @id @default(uuid())
  category    BalanceSheetCategory
  label       String
  amountCents Int
  asOfDate    DateTime
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([category])
  @@index([asOfDate])
}

// ── Quoting: Good / Better / Best Bundles ──

enum BundleTier {
  good
  better
  best
  custom
}

enum BundlePricingMethod {
  calculated
  price_per_foot
  markup_percent
}

model QuoteBundle {
  id                    String              @id @default(uuid())
  name                  String
  description           String?
  tier                  BundleTier          @default(better)
  tierLabel             String? // custom label when tier=custom
  fenceStyleId          String // references configStore fence style ID
  groupName             String? // bundle group identifier (ties trio/duo together)
  pricingMethod         BundlePricingMethod @default(calculated)
  marginOverride        Float? // decimal, e.g. 0.64
  laborRateOverride     Float? // $/hr
  pricePerFootOverride  Int? // cents per linear foot
  materialMarkupPercent Float? // decimal, e.g. 0.15 = 15%
  isActive              Boolean             @default(true)
  sortOrder             Int                 @default(0)
  highlightBadge        String? // "Most Popular", "Best Value", etc.
  isRecommended         Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  inclusions QuoteBundleInclusion[]
  addons     QuoteBundleAddon[]
  options    QuoteOption[]

  @@index([fenceStyleId])
  @@index([groupName])
  @@index([tier])
  @@index([isActive])
}

model QuoteBundleInclusion {
  id          String   @id @default(uuid())
  bundleId    String
  label       String
  description String?
  isFeatured  Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  bundle QuoteBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([bundleId])
}

model QuoteBundleAddon {
  id                  String   @id @default(uuid())
  bundleId            String
  addonName           String
  addonPriceCents     Int
  isIncludedByDefault Boolean  @default(false)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())

  bundle QuoteBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([bundleId])
}

// ── Inventory Pending Orders ──

enum PendingOrderStatus {
  pending
  ordered
  received
  cancelled
}

model InventoryPendingOrder {
  id             String             @id @default(uuid())
  quoteId        String
  jobId          String?
  customerId     String?
  customerName   String?
  quoteName      String?
  status         PendingOrderStatus @default(pending)
  totalCostCents Int                @default(0)
  notes          String?
  orderedAt      DateTime?
  receivedAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  items InventoryPendingOrderItem[]

  @@index([quoteId])
  @@index([customerId])
  @@index([status])
}

model InventoryPendingOrderItem {
  id               String    @id @default(uuid())
  pendingOrderId   String
  inventoryItemId  String?
  itemName         String
  requiredQuantity Float
  unitCostCents    Int
  totalCostCents   Int
  quantityReceived Float     @default(0)
  receivedAt       DateTime?
  createdAt        DateTime  @default(now())

  order InventoryPendingOrder @relation(fields: [pendingOrderId], references: [id], onDelete: Cascade)

  @@index([pendingOrderId])
}

model QuoteOption {
  id                String    @id @default(uuid())
  quoteId           String // references localStorage quote ID or server quote ID
  bundleId          String?
  tierLabel         String // good, better, best, or custom
  fenceStyleId      String
  sectionCount      Int       @default(0)
  gateCount         Int       @default(0)
  footage           Float     @default(0)
  materialCostCents Int       @default(0)
  laborCostCents    Int       @default(0)
  overheadCents     Int       @default(0)
  commissionCents   Int       @default(0)
  quotePriceCents   Int       @default(0)
  marginPercent     Float     @default(0)
  netProfitCents    Int       @default(0)
  pricePerFootCents Int       @default(0)
  isRecommended     Boolean   @default(false)
  presentationOrder Int       @default(0)
  status            String    @default("draft") // draft, presented, accepted, declined
  acceptedAt        DateTime?
  acceptedBy        String? // customer email or name who accepted
  shareToken        String?   @unique // for public customer presentation
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  bundle QuoteBundle? @relation(fields: [bundleId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([bundleId])
  @@index([shareToken])
  @@index([status])
}

// ── CRM Contacts (database-backed customers used by the CRM web app) ──
//
// Distinct from `Customer` (which is the customer-portal login account).
// A CrmContact may have an attached `Customer` once portal access is granted,
// but most CrmContacts never use the customer portal — they are simply leads /
// jobsite contacts that the CRM operator wants persisted in the database
// instead of localStorage. Every field is optional after first/last name so
// new fields can be added without breaking existing rows.
model CrmContact {
  id               String    @id @default(uuid())
  accountId        String? // CrmAccount this contact belongs to (the visibility scope)
  ownerId          String? // CrmUser.id of the original creator — audit trail only
  firstName        String
  lastName         String
  email            String?
  phone            String?
  serviceAddress   String?
  billingAddress   String?
  billingDifferent Boolean   @default(false)
  city             String?
  state            String?
  zip              String?
  leadSource       String?
  salesRep         String?
  firstApptDate    String?
  tags             Json? // string[] of tags
  notes            String?
  jobStatus        String? // First Contact / Appointment / ...  mirrors pipeline stage if known
  isCompleted      Boolean   @default(false)
  // Linkage back to the customer-portal account, if one exists
  portalCustomerId String?
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  account      CrmAccount?      @relation("ContactsOfCrmAccount", fields: [accountId], references: [id])
  contactNotes CrmContactNote[]
  savedQuotes  SavedQuote[]
  savedJobs    SavedJob[]

  @@index([accountId])
  @@index([ownerId])
  @@index([email])
  @@index([archivedAt])
  @@index([jobStatus])
}

// ── CRM Contact Notes — staff notes attached to a CrmContact ──
//
// Replaces the prior localStorage-backed billingStore CustomerNote. Visible to
// every staff user in the same CrmAccount; survives device switches and
// browser clears. Notes are soft deleted via deletedAt so accidental deletes
// can be recovered from the audit log.
enum CrmContactNoteVisibility {
  internal // hidden from non-admin staff (future use)
  all_staff // visible to every staff user in the account
}

model CrmContactNote {
  id           String                   @id @default(uuid())
  crmContactId String
  accountId    String // denormalized for fast tenant scoping
  body         String
  isPinned     Boolean                  @default(false)
  visibility   CrmContactNoteVisibility @default(all_staff)
  createdBy    String // display name or user identifier
  createdById  String? // CrmUser.id of the author, when known
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  deletedAt    DateTime?

  contact CrmContact @relation(fields: [crmContactId], references: [id], onDelete: Cascade)

  @@index([crmContactId])
  @@index([accountId])
  @@index([deletedAt])
}

// ── CRM Audit Log — every CRUD op on important CRM-side entities ──
//
// Distinct from the existing AuditLog model (which is tied to the customer-
// portal Customer table). This is the staff-side / CRM-side audit log.
// Records what changed, who did it, and the before/after JSON so accidental
// changes can be precisely reversed. Hooked from the new audit() helper in
// apps/portal/src/server/lib/auditLog.ts. Emit-only by default; the Admin
// Audit Log page reads it via /api/admin/audit-log.
model CrmAuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  action     String // 'create' | 'update' | 'delete' | 'soft_delete' | 'login' | 'logout' | 'invite_sent' | 'invite_accepted' | 'role_changed' | 'settings_changed' | etc.
  entityType String // 'CrmContact' | 'Quote' | 'Job' | 'Invoice' | ...
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}

// ── Backup Log — every backup attempt (daily, pre-deploy, restore) ──
model BackupLog {
  id            String   @id @default(uuid())
  backupType    String // 'daily' | 'pre-deploy' | 'restore' | 'manual'
  filePath      String
  remoteUrl     String? // s3:// path if uploaded
  fileSizeBytes BigInt   @default(0)
  status        String // 'success' | 'failed' | 'partial'
  startedAt     DateTime
  completedAt   DateTime
  errorMessage  String?
  createdAt     DateTime @default(now())

  @@index([backupType, createdAt])
  @@index([status])
}

// ── Monitoring Snapshots — daily count of key entities ──
//
// One row per day per company-tenant. Drives the /api/health endpoint's
// `database.counts` field and the daily-anomaly alert that fires when any
// count drops by more than 5 records day-over-day.
model MonitoringSnapshot {
  id                 String   @id @default(uuid())
  snapshotDate       DateTime @unique // truncated to YYYY-MM-DD UTC
  customerCount      Int      @default(0)
  contactCount       Int      @default(0)
  quoteCount         Int      @default(0)
  jobCount           Int      @default(0)
  invoiceCount       Int      @default(0)
  paymentCount       Int      @default(0)
  documentCount      Int      @default(0)
  portalAccountCount Int      @default(0)
  createdAt          DateTime @default(now())

  @@index([snapshotDate])
}

// ── Saved Quotes — the user's saved quotes from QuoteBuilder ──
//
// Replaces the prior localStorage-backed `fencepro_quotes` blob. Distinct from
// QuoteOption (per-quote bundle option for Good/Better/Best) and from the
// stateless `/api/quotes/calculate` chatbot endpoint. Money fields are Float
// to match the existing client-side calculator chain (cents-integer migration
// is a separate cross-cutting effort, see EZBIZ_KNOWN_ISSUES.md issue #3).
enum SavedQuoteStatus {
  DRAFT
  SENT
  SOLD
  LOST
}

model SavedQuote {
  id        String  @id @default(uuid())
  accountId String // tenant scope
  ownerId   String? // CrmUser.id of original creator (audit trail)

  // Customer link (preferred) + denormalized snapshot fields so quotes survive
  // contact deletes and so public share pages don't need to join.
  crmContactId    String?
  customerName    String  @default("")
  customerPhone   String  @default("")
  customerEmail   String  @default("")
  customerAddress String  @default("")
  leadSource      String  @default("")
  salesRep        String  @default("")

  // Job spec
  fenceStyle      String  @default("")
  runs            Json // number[] of run lengths in feet
  runRails        Json? // ('auto' | '6ft' | '8ft')[] for vinyl auto-mix
  corners         Int     @default(0)
  ends            Int     @default(0)
  walkGates       Int     @default(0)
  dblGates        Int     @default(0)
  tearOutSections Int     @default(0)
  tearOutGates    Int     @default(0)
  adjLaborHrs     Float   @default(0)
  hasSalesman     Boolean @default(false)
  priceAdjust     Float   @default(0)

  // Computed snapshot (frozen at save time)
  sections     Int   @default(0)
  materialCost Float @default(0)
  laborCost    Float @default(0)
  tearOutCost  Float @default(0)
  totalCOGS    Float @default(0)
  finalPrice   Float @default(0)
  gmPct        Float @default(0)
  pullSheet    Json // LineItem[] from materialCalculator

  status   SavedQuoteStatus @default(DRAFT)
  date     String           @default("") // YYYY-MM-DD legacy format
  notes    String           @default("")
  leadTemp Int              @default(0)

  // Public sharing token used by #/quote/:token and #/present/:token routes.
  // Generated server-side on first request to share the quote. Unique so the
  // link is unguessable.
  shareToken        String?   @unique
  // Timestamp of the first time a customer hit the public share page; null
  // until then. Drives the "viewed" badge + automation trigger.
  firstViewedAt     DateTime?
  viewCount         Int       @default(0)
  // Customer-side acceptance — recorded by POST /api/saved-quotes/share/:token/accept
  acceptedAt        DateTime?
  acceptedBy        String? // typed name or display name from the accept form
  acceptedSignature String? // base64 data URL of the signature image, if any

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  account CrmAccount? @relation("QuotesOfCrmAccount", fields: [accountId], references: [id])
  contact CrmContact? @relation(fields: [crmContactId], references: [id])

  @@index([accountId])
  @@index([crmContactId])
  @@index([status])
  @@index([shareToken])
  @@index([archivedAt])
}

// ── Saved Jobs — operational job records spawned from sold quotes ──
//
// Replaces the prior localStorage-backed `fencepro_jobs` blob. Named
// SavedJob to mirror SavedQuote and avoid colliding with any future
// generic Job model (none today). Money fields are Float to match the
// existing client side calculator chain.
enum SavedJobStatus {
  staging
  scheduled
  in_progress
  completed
  invoiced
  paid
  on_hold
}

enum SavedJobMaterialsStatus {
  not_ordered
  ordered
  received
  loaded
}

enum SavedJobPaymentStatus {
  not_invoiced
  invoiced
  partial
  paid
}

model SavedJob {
  id           String  @id @default(uuid())
  accountId    String // tenant scope
  quoteId      String? // SavedQuote.id; optional for legacy / hand created jobs
  crmContactId String?

  status         SavedJobStatus  @default(staging)
  previousStatus SavedJobStatus?

  // Customer snapshot
  customerName    String @default("")
  customerPhone   String @default("")
  customerEmail   String @default("")
  customerAddress String @default("")

  // Scope (snapshot from quote)
  fenceStyle      String  @default("")
  sections        Int     @default(0)
  totalFeet       Int     @default(0)
  walkGates       Int     @default(0)
  dblGates        Int     @default(0)
  tearOutSections Int     @default(0)
  hasSalesman     Boolean @default(false)

  // Geolocation (for smart scheduling)
  lat Float?
  lng Float?

  // Pricing
  quotePrice       Float @default(0)
  changeOrderTotal Float @default(0)
  contractValue    Float @default(0)
  gmPct            Float @default(0)

  // Operations — staging
  materialsStatus SavedJobMaterialsStatus @default(not_ordered)
  pullSheetPulled Boolean                 @default(false)
  locatesDate     String?
  locatesExpDate  String?
  drawingComplete Boolean                 @default(false)

  // Operations — scheduling
  crewAssigned     String  @default("")
  scheduledDate    String  @default("")
  scheduledEndDate String?
  estimatedDays    Int     @default(0)

  // Operations — completion
  completedDate String?
  completedBy   String?
  actualDays    Int?

  // Payment
  invoiceNumber String?
  invoiceDate   String?
  paymentStatus SavedJobPaymentStatus @default(not_invoiced)
  amountPaid    Float                 @default(0)
  paymentDate   String?
  paymentMethod String?

  // Meta
  notes      String  @default("")
  holdReason String?
  salesRep   String  @default("")
  leadSource String  @default("")

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  account CrmAccount? @relation("JobsOfCrmAccount", fields: [accountId], references: [id])
  contact CrmContact? @relation(fields: [crmContactId], references: [id])

  @@index([accountId])
  @@index([crmContactId])
  @@index([quoteId])
  @@index([status])
  @@index([archivedAt])
}

// ── Schedule Settings — account-scoped configurable work days + crews ──
//
// Singleton per CrmAccount. workDays is a JSON array of weekday integers
// (0 = Sunday … 6 = Saturday); crews is a JSON array of {id, name, color}
// objects. Kept as JSON to match the existing client side shape exactly.
model ScheduleSettings {
  id        String   @id @default(uuid())
  accountId String   @unique
  workDays  Json // number[] — defaults [1,2,3,4]
  crews     Json // {id,name,color}[]
  lat       Float? // optional weather widget centerpoint
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account CrmAccount @relation(fields: [accountId], references: [id])
}

// ── Scheduled Grid Job — denormalized entries shown on the Schedule grid ──
//
// Distinct from SavedJob (which holds the canonical job lifecycle). Each
// row here is a particular day-and-crew assignment as it appears on the
// schedule page; can reference a staging job or a SavedJob via stagingJobId.
enum ScheduledGridJobStatus {
  Scheduled
  InProgress
  Complete
  RainDay
  RolledOver
}

model ScheduledGridJob {
  id           String                 @id @default(uuid())
  accountId    String
  stagingJobId String? // SavedJob.id when applicable
  clientName   String                 @default("")
  area         String                 @default("")
  sections     Int                    @default(0)
  fenceType    String                 @default("")
  jobPrice     Float                  @default(0)
  tearout      Boolean                @default(false)
  crewId       String                 @default("")
  date         String                 @default("") // YYYY-MM-DD
  notes        String                 @default("")
  status       ScheduledGridJobStatus @default(Scheduled)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  account CrmAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([date])
  @@index([crewId])
  @@index([status])
}

// ── Schedule Rain Day Log — append-only log of rain-day flags ──
model ScheduleRainDay {
  id             String   @id @default(uuid())
  accountId      String
  jobId          String // ScheduledGridJob.id at the time of flagging
  clientName     String   @default("")
  originalDate   String   @default("") // YYYY-MM-DD
  rescheduleDate String   @default("") // empty = TBD
  reason         String   @default("")
  flaggedAt      DateTime @default(now())

  account CrmAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([flaggedAt])
}

// ── Pipeline State — singleton per account holding the sales pipeline ──
//
// Replaces the prior `localStorage.fencepro_pipeline` blob. The shape
// (`{ leads: PipelineLead[], stages: Stage[] }`) is preserved so the
// existing SalesPipelineBoard kanban / list view, drag and drop, and
// stage rename UI keep working unchanged. Stored as JSON because the
// kanban consumes the whole list in memory; if normalized queries are
// ever needed, leads can be split out into their own table later.
model PipelineState {
  id        String   @id @default(uuid())
  accountId String   @unique
  leads     Json // PipelineLead[]
  stages    Json // Stage[] (id, name, color, etc.)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account CrmAccount @relation(fields: [accountId], references: [id])
}

// ── Inventory State — singleton per account ──
//
// Replaces the prior `localStorage.fencepro_inventory` blob plus the
// associated bundles, locations, stock levels, and transaction log. Stored
// as a single JSON document because the inventory page consumes the full
// catalog in memory; if transaction volume becomes a problem the audit log
// can be split into its own table later.
model InventoryState {
  id           String   @id @default(uuid())
  accountId    String   @unique
  items        Json // InventoryItem[]
  bundles      Json // Bundle[]
  locations    Json // InventoryLocation[]
  stockLevels  Json // StockLevel[]
  transactions Json // InventoryTransaction[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account CrmAccount @relation(fields: [accountId], references: [id])
}

// ── Vendor State — singleton per account holding AP-side vendor data ──
//
// Replaces the prior fencepro_vendors / fencepro_vendor_bills /
// fencepro_vendor_payments localStorage trio. Note: normalized
// VendorContact / VendorBill / VendorPayment models also exist on this
// schema (added in earlier rebrand work) but are not yet wired into the
// frontend. Phase 7 takes the simpler JSON-blob route to match the
// existing client; a follow up phase can migrate to those normalized
// models if and when fine-grained queries are needed.
model VendorState {
  id        String   @id @default(uuid())
  accountId String   @unique
  vendors   Json // VendorContact[]
  bills     Json // VendorBill[]
  payments  Json // VendorPayment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account CrmAccount @relation(fields: [accountId], references: [id])
}

// ── Business State — singleton per account holding Phase 8 + 9 config ──
//
// One blob covering bundles + quote options + contract sections + job
// checklists + default milestones (Phase 8) and the Phase 9 finance and
// settings stores (P&L manual entries, balance sheet entries, cash flow
// manual lines, automations, email templates, settings, company config,
// budget). Each sub-field is JSON. Fields are added incrementally per
// phase; missing fields default to empty arrays / objects on the client.
model BusinessState {
  id                String   @id @default(uuid())
  accountId         String   @unique
  // Phase 8
  bundles           Json     @default("[]") // QuoteBundle[]
  quoteOptions      Json     @default("[]") // QuoteOption[]
  contractSections  Json     @default("[]") // ContractSection[]
  jobChecklists     Json     @default("{}") // Record<jobId, ChecklistItem[]>
  defaultMilestones Json     @default("[]") // string[]
  // Phase 9
  plEntries         Json     @default("[]") // PlManualEntry[]
  balanceSheet      Json     @default("[]") // BalanceSheetEntry[]
  cashFlowManual    Json     @default("[]") // CashFlowManualLine[]
  automations       Json     @default("[]") // Automation[]
  emailTemplates    Json     @default("{}") // Record<key, EmailTemplate>
  settings          Json     @default("{}") // catch all UI settings
  config            Json     @default("{}") // company info, fence styles, pricing, etc.
  budget            Json     @default("{}") // BudgetState
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  account CrmAccount @relation(fields: [accountId], references: [id])
}
