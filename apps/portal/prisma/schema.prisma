// ── CRM Users & Auth ──

enum CrmUserRole {
  super_admin
  admin
  manager
  sales_rep
  field_crew
  office_staff
  customer
}

enum CrmUserStatus {
  active
  invited
  suspended
  deactivated
}

model CrmUser {
  id                   String        @id @default(uuid())
  email                String        @unique
  passwordHash         String?
  firstName            String
  lastName             String
  phone                String?
  avatarUrl            String?
  role                 CrmUserRole   @default(office_staff)
  status               CrmUserStatus @default(invited)
  invitedById          String?
  inviteTokenHash      String?       @unique
  inviteTokenExpiresAt DateTime?
  mustChangePassword   Boolean       @default(true)
  failedLoginAttempts  Int           @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  customerId           String? // for customer portal users
  crmAccountId         String? // company / tenant this staff user belongs to
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  invitedBy   CrmUser?          @relation("UserInvites", fields: [invitedById], references: [id])
  invitees    CrmUser[]         @relation("UserInvites")
  sessions    CrmUserSession[]
  activityLog CrmUserActivity[]
  crmAccount  CrmAccount?       @relation("StaffOfCrmAccount", fields: [crmAccountId], references: [id])

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([inviteTokenHash])
  @@index([crmAccountId])
}

model CrmUserSession {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  /// How this sign in is carried: null = the old app token (refresh token hash in tokenHash),
  /// 'cookie' = the ezbiz_staff cookie (SHA-256 of the cookie value in tokenHash, lib/staffSession.ts),
  /// 'readonly' = the Mac's 3 hour read only checker (scripts/readonly-session.ts).
  kind       String?
  /// Last request made with it (cookie sessions end 30 days after this, and never later than expiresAt).
  lastUsedAt DateTime?
  /// Every request that is not a read is refused (the read only checker).
  readOnly   Boolean   @default(false)
  /// Shown in Settings > Team ("Read only checker on the Mac").
  label      String?

  user CrmUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model CrmUserActivity {
  id         String   @id @default(uuid())
  userId     String
  action     String // login, logout, invite_sent, role_changed, job_created, etc.
  entityType String? // job, quote, customer, user, etc.
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user CrmUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ── Finance: Vendor Management & Accounts Payable ──

enum VendorPaymentTerms {
