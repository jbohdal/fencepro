generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──

enum Role {
  customer
  admin
  support_agent
}

enum TicketStatus {
  open
  in_progress
  waiting_customer
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

enum InvoiceStatus {
  pending
  paid
  overdue
  cancelled
  refunded
}

enum AccountStatus {
  active
  suspended
  cancelled
}

// ── Models ──

model Customer {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  role          Role      @default(customer)
  accountId     String
  portalEnabled Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  account       CrmAccount  @relation(fields: [accountId], references: [id])
  documents     Document[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  chats         ChatConversation[]

  @@index([accountId])
  @@index([email])
}

model CrmAccount {
  id               String        @id @default(uuid())
  externalCrmId    String?       @unique
  name             String
  status           AccountStatus @default(active)
  assignedRepName  String?
  assignedRepEmail String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  customers  Customer[]
  documents  Document[]
  tickets    Ticket[]
  invoices   Invoice[]
  contracts  Contract[]

  @@index([externalCrmId])
}

model Document {
  id             String    @id @default(uuid())
  customerId     String
  accountId      String
  filename       String
  originalName   String
  storagePath    String
  mimeType       String
  sizeBytes      Int
  linkedEntity   String?   // 'ticket', 'contract', 'invoice'
  linkedEntityId String?
  uploadedAt     DateTime  @default(now())
  deletedAt      DateTime?

  customer Customer   @relation(fields: [customerId], references: [id])
  account  CrmAccount @relation(fields: [accountId], references: [id])

  @@index([customerId])
  @@index([accountId])
  @@index([linkedEntity, linkedEntityId])
}

model Ticket {
  id            String         @id @default(uuid())
  externalCrmId String?        @unique
  accountId     String
  title         String
  description   String?
  status        TicketStatus   @default(open)
  priority      TicketPriority @default(medium)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  account  CrmAccount     @relation(fields: [accountId], references: [id])
  comments TicketComment[]

  @@index([accountId])
  @@index([status])
}

model TicketComment {
  id         String   @id @default(uuid())
  ticketId   String
  authorName String
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Invoice {
  id            String        @id @default(uuid())
  externalCrmId String?       @unique
  accountId     String
  invoiceNumber String
  amountCents   Int
  currency      String        @default("USD")
  dueDate       DateTime
  paidAt        DateTime?
  status        InvoiceStatus @default(pending)
  pdfPath       String?
  createdAt     DateTime      @default(now())

  account CrmAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([status])
}

model Contract {
  id            String   @id @default(uuid())
  externalCrmId String?  @unique
  accountId     String
  name          String
  description   String?
  startDate     DateTime
  endDate       DateTime?
  status        String   @default("active") // active, expired, cancelled
  createdAt     DateTime @default(now())

  account CrmAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
}

model AuditLog {
  id         String   @id @default(uuid())
  customerId String?
  action     String   // login, logout, upload, download, ticket_create, ticket_reply, etc.
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([action])
  @@index([createdAt])
}

model RefreshToken {
  id         String   @id @default(uuid())
  customerId String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([customerId])
}

// ── Chat ──

enum ChatStatus {
  active
  resolved
  escalated
}

model ChatConversation {
  id         String     @id @default(uuid())
  customerId String
  accountId  String
  status     ChatStatus @default(active)
  summary    String?
  ticketId   String?    // set when escalated to a ticket
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  customer Customer      @relation(fields: [customerId], references: [id])
  messages ChatMessage[]

  @@index([customerId])
  @@index([accountId])
  @@index([status])
}

model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String   // 'customer', 'assistant', 'agent'
  body           String
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ── Lead Generation (Botpress chatbot → backend) ──

enum LeadStage {
  new_lead
  qualified
  appointment_scheduled
  contacted
  proposal_sent
  won
  lost
}

enum LeadUrgency {
  asap
  one_to_three_months
  three_to_six_months
  just_looking
}

enum FollowUpStatus {
  pending
  sent
  failed
  cancelled
}

model Lead {
  id              String       @id @default(uuid())
  // Contact info
  firstName       String?
  lastName        String?
  email           String?
  phone           String?
  address         String?
  city            String?
  state           String?
  zipCode         String?
  // Project details
  fenceType       String?      // vinyl, aluminum, wood, chain_link, etc.
  linearFootage   Int?
  propertyType    String?      // residential, commercial
  timeline        LeadUrgency?
  budgetMin       Int?         // cents
  budgetMax       Int?         // cents
  notes           String?
  // Qualification
  stage           LeadStage    @default(new_lead)
  score           Int          @default(0)  // 0-100
  scoringDetails  Json?        // breakdown of how score was calculated
  tags            String[]     @default([])
  // Botpress
  botpressConversationId String? @unique
  transcript      Json?        // full chat transcript from Botpress
  // Assignment
  assignedRepName  String?
  assignedRepEmail String?
  // Lifecycle
  source          String       @default("website_chat")
  convertedAt     DateTime?
  lostReason      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  appointments Appointment[]
  followUps    FollowUp[]

  @@index([stage])
  @@index([email])
  @@index([zipCode])
  @@index([score])
  @@index([createdAt])
}

model Appointment {
  id            String    @id @default(uuid())
  leadId        String
  scheduledAt   DateTime
  duration      Int       @default(60) // minutes
  type          String    @default("estimate") // estimate, follow_up, consultation
  location      String?   // address for the estimate visit
  notes         String?
  confirmed     Boolean   @default(false)
  cancelledAt   DateTime?
  completedAt   DateTime?
  reminderSent  Boolean   @default(false)
  // Google Calendar sync
  googleCalendarEventId String?  // GCal event ID for sync
  assignedRepEmail      String?  // salesman's email whose calendar gets the event
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([scheduledAt])
}

// ── Google Calendar OAuth Tokens ──

model GoogleCalendarToken {
  id           String   @id @default(uuid())
  email        String   @unique  // the Google account email
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

model FollowUp {
  id           String         @id @default(uuid())
  leadId       String
  type         String         // sms, email
  channel      String         @default("sms") // sms, email
  message      String
  scheduledFor DateTime
  sentAt       DateTime?
  status       FollowUpStatus @default(pending)
  errorMessage String?
  createdAt    DateTime       @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([status, scheduledFor])
}

model PricingRule {
  id            String   @id @default(uuid())
  fenceType     String   @unique
  displayName   String
  minPerFoot    Int      // cents per linear foot (low end)
  maxPerFoot    Int      // cents per linear foot (high end)
  description   String?
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Chatbot Knowledge Base ──

model KnowledgeEntry {
  id          String   @id @default(uuid())
  category    String   // faq, policy, materials, process, warranty, financing, etc.
  title       String
  content     String   // the actual knowledge — markdown supported
  keywords    String[] @default([]) // help the bot match relevant entries
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([active])
}

// ── EZ Budget — Instant Quoting Module ──

enum EzBudgetQuoteStatus {
  draft
  sent
  viewed
  accepted
  declined
  expired
}

model EzBudgetService {
  id            String   @id @default(uuid())
  name          String
  description   String?
  category      String?              // grouping label (e.g., "Vinyl", "Chain Link")
  unitLabel     String   @default("per linear foot") // display unit
  basePriceCents Int                 // default price in cents
  minQty        Int?                 // optional minimum quantity
  maxQty        Int?                 // optional maximum quantity
  imageUrl      String?
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  metadata      Json?                // flexible extra fields
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lineItems EzBudgetLineItem[]

  @@index([active])
  @@index([category])
}

model EzBudgetQuote {
  id              String               @id @default(uuid())
  quoteNumber     String               @unique @default(uuid())
  status          EzBudgetQuoteStatus  @default(draft)
  // Customer info (captured by widget)
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  customerAddress String?
  customerCity    String?
  customerState   String?
  customerZip     String?
  // Totals
  subtotalCents   Int       @default(0)
  discountCents   Int       @default(0)
  taxCents        Int       @default(0)
  totalCents      Int       @default(0)
  // Fence map data
  mapData         Json?                // { coordinates, fenceLine, runs, layout, gateConfig }
  material        String?              // vinyl, aluminum, etc.
  style           String?              // vinyl-full-privacy, etc.
  height          String?              // 4ft, 5ft, 6ft, 8ft
  color           String?
  linearFeet      Float?
  requestOnSite   Boolean   @default(false)
  photos          String[]  @default([])
  // Metadata
  notes           String?
  internalNotes   String?
  source          String    @default("widget")  // widget, manual, api
  expiresAt       DateTime?
  viewedAt        DateTime?
  respondedAt     DateTime?
  // Lifecycle
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lineItems EzBudgetLineItem[]

  @@index([status])
  @@index([customerEmail])
  @@index([createdAt])
}

model EzBudgetLineItem {
  id            String   @id @default(uuid())
  quoteId       String
  serviceId     String?
  label         String               // display name (snapshot from service or custom)
  quantity      Float    @default(1)
  unitPriceCents Int
  totalCents    Int
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  quote   EzBudgetQuote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service EzBudgetService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([serviceId])
}

model EzBudgetSettings {
  id              String   @id @default(uuid())
  key             String   @unique
  value           Json
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ── Automation Engine ──

enum AutomationTriggerType {
  sales_stage_change
  ops_stage_change
  job_created
  job_assigned
  job_scheduled
  job_rescheduled
  stale_job              // no status update for X days
  deadline_approaching   // X days before a due date
  form_submitted
  payment_received
  customer_no_response
  rain_day_flagged
}

enum AutomationActionType {
  move_ops_stage
  move_sales_stage
  send_email
  send_notification
  create_task
  schedule_reminder
  post_activity_note
  fire_webhook
  require_checklist_gate
}

enum AutomationRunStatus {
  success
  partial
  failed
}

model Automation {
  id             String                @id @default(uuid())
  name           String
  description    String?
  triggerType    AutomationTriggerType
  triggerConfig  Json                  // { fromStage?, toStage?, daysOffset?, stageKey? }
  actions        Json                  // [{ type, config }] — ordered action array
  conditions     Json?                 // optional filters: { assignedRep?, fenceType?, businessHoursOnly? }
  isActive       Boolean               @default(true)
  createdBy      String?
  lastFiredAt    DateTime?
  fireCount      Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  runLogs AutomationRunLog[]

  @@index([isActive])
  @@index([triggerType])
}

model AutomationRunLog {
  id              String              @id @default(uuid())
  automationId    String
  automationName  String              // snapshot in case automation is later deleted
  jobId           String?             // the job that triggered it (localStorage ID or external ref)
  jobName         String?             // snapshot: customer name or job label
  triggerType     String
  actionsExecuted Json                // [{ type, config, result, error? }]
  status          AutomationRunStatus
  errorMessage    String?
  firedAt         DateTime            @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([jobId])
  @@index([firedAt])
}

// ── Tasks (created by automations or manually) ──

enum TaskStatus {
  pending
  in_progress
  completed
  cancelled
}

enum TaskPriority {
  low
  normal
  high
  urgent
}

model Task {
  id            String       @id @default(uuid())
  title         String
  description   String?
  assignedTo    String?      // user name or role
  assignedRole  String?      // owner, admin, salesman, ops_manager, shop
  jobId         String?      // linked job ID
  jobName       String?      // snapshot
  status        TaskStatus   @default(pending)
  priority      TaskPriority @default(normal)
  dueDate       DateTime?
  completedAt   DateTime?
  createdBy     String?      // "automation:ID" or user name
  automationId  String?      // if created by automation
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([assignedTo])
  @@index([assignedRole])
  @@index([dueDate])
  @@index([jobId])
}

// ── In-App Notifications ──

model Notification {
  id          String   @id @default(uuid())
  recipientId String?  // user name or ID
  recipientRole String? // broadcast to role
  title       String
  body        String
  type        String   @default("info") // info, warning, success, error, automation
  link        String?  // deep link within app (e.g., "/jobs/123")
  jobId       String?
  read        Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([recipientId, read])
  @@index([recipientRole, read])
  @@index([createdAt])
}

// ── Integration Framework ──

enum IntegrationStatus {
  connected
  disconnected
  error
}

model Integration {
  id            String            @id @default(uuid())
  name          String
  slug          String            @unique // twilio, google_calendar, stripe, etc.
  category      String            // Communication, Payments, Scheduling, etc.
  description   String?
  logoUrl       String?
  isActive      Boolean           @default(false)
  config        Json?             // encrypted credentials + settings
  capabilities  String[]          @default([]) // send_sms, sync_calendar, etc.
  connectedBy   String?
  connectedAt   DateTime?
  lastSyncedAt  DateTime?
  status        IntegrationStatus @default(disconnected)
  errorLog      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  activityLogs IntegrationLog[]

  @@index([slug])
  @@index([isActive])
  @@index([category])
}

model IntegrationLog {
  id            String   @id @default(uuid())
  integrationId String
  action        String   // connect, disconnect, sync, webhook_in, webhook_out, error
  details       String?
  payload       Json?
  status        String   @default("success") // success, error
  errorMessage  String?
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([createdAt])
}

// ── API Keys ──

model ApiKey {
  id            String    @id @default(uuid())
  name          String
  keyHash       String    @unique  // bcrypt hash of the actual key
  keyPrefix     String             // first 8 chars for display (e.g., "fp_live_a3b2...")
  scope         String    @default("read") // read, read_write, admin
  createdBy     String
  lastUsedAt    DateTime?
  requestCount  Int       @default(0)
  isActive      Boolean   @default(true)
  revokedAt     DateTime?
  revokedBy     String?
  createdAt     DateTime  @default(now())

  usageLogs ApiKeyUsageLog[]

  @@index([keyHash])
  @@index([isActive])
}

model ApiKeyUsageLog {
  id          String   @id @default(uuid())
  apiKeyId    String
  endpoint    String
  method      String
  statusCode  Int
  ipAddress   String?
  createdAt   DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([createdAt])
}

// ── Inbound Webhook Log ──

model WebhookInboundLog {
  id            String   @id @default(uuid())
  source        String   // stripe, companycam, zapier, etc.
  endpoint      String
  payload       Json?
  headers       Json?
  status        String   @default("received") // received, processed, failed, queued
  errorMessage  String?
  processedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([source])
  @@index([status])
  @@index([createdAt])
}
