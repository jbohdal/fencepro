// ── Quoting: Good / Better / Best Bundles ──

enum BundleTier {
  good
  better
  best
  custom
}

enum BundlePricingMethod {
  calculated
  price_per_foot
  markup_percent
}

model QuoteBundle {
  id                    String              @id @default(uuid())
  name                  String
  description           String?
  tier                  BundleTier          @default(better)
  tierLabel             String? // custom label when tier=custom
  fenceStyleId          String // references configStore fence style ID
  groupName             String? // bundle group identifier (ties trio/duo together)
  pricingMethod         BundlePricingMethod @default(calculated)
  marginOverride        Float? // decimal, e.g. 0.64
  laborRateOverride     Float? // $/hr
  pricePerFootOverride  Int? // cents per linear foot
  materialMarkupPercent Float? // decimal, e.g. 0.15 = 15%
  isActive              Boolean             @default(true)
  sortOrder             Int                 @default(0)
  highlightBadge        String? // "Most Popular", "Best Value", etc.
  isRecommended         Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  inclusions QuoteBundleInclusion[]
  addons     QuoteBundleAddon[]
  options    QuoteOption[]

  @@index([fenceStyleId])
  @@index([groupName])
  @@index([tier])
  @@index([isActive])
}

model QuoteBundleInclusion {
  id          String   @id @default(uuid())
  bundleId    String
  label       String
  description String?
  isFeatured  Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  bundle QuoteBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([bundleId])
}

model QuoteBundleAddon {
  id                  String   @id @default(uuid())
  bundleId            String
  addonName           String
  addonPriceCents     Int
  isIncludedByDefault Boolean  @default(false)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())

  bundle QuoteBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([bundleId])
}

// ── Inventory Pending Orders ──

enum PendingOrderStatus {
  pending
  ordered
  received
  cancelled
}

model InventoryPendingOrder {
  id             String             @id @default(uuid())
  quoteId        String
  jobId          String?
  customerId     String?
  customerName   String?
  quoteName      String?
  status         PendingOrderStatus @default(pending)
  totalCostCents Int                @default(0)
  notes          String?
  orderedAt      DateTime?
  receivedAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  items InventoryPendingOrderItem[]

  @@index([quoteId])
  @@index([customerId])
  @@index([status])
}

model InventoryPendingOrderItem {
  id               String    @id @default(uuid())
  pendingOrderId   String
  inventoryItemId  String?
  itemName         String
  requiredQuantity Float
  unitCostCents    Int
  totalCostCents   Int
  quantityReceived Float     @default(0)
  receivedAt       DateTime?
  createdAt        DateTime  @default(now())

  order InventoryPendingOrder @relation(fields: [pendingOrderId], references: [id], onDelete: Cascade)

  @@index([pendingOrderId])
}

model QuoteOption {
  id                String    @id @default(uuid())
  quoteId           String // references localStorage quote ID or server quote ID
  bundleId          String?
  tierLabel         String // good, better, best, or custom
  fenceStyleId      String
  sectionCount      Int       @default(0)
  gateCount         Int       @default(0)
  footage           Float     @default(0)
  materialCostCents Int       @default(0)
  laborCostCents    Int       @default(0)
  overheadCents     Int       @default(0)
  commissionCents   Int       @default(0)
  quotePriceCents   Int       @default(0)
  marginPercent     Float     @default(0)
  netProfitCents    Int       @default(0)
  pricePerFootCents Int       @default(0)
  isRecommended     Boolean   @default(false)
  presentationOrder Int       @default(0)
  status            String    @default("draft") // draft, presented, accepted, declined
  acceptedAt        DateTime?
  acceptedBy        String? // customer email or name who accepted
  shareToken        String?   @unique // for public customer presentation
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  bundle QuoteBundle? @relation(fields: [bundleId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([bundleId])
  @@index([shareToken])
  @@index([status])
}

// ── CRM Contacts (database-backed customers used by the CRM web app) ──
//
// Distinct from `Customer` (which is the customer-portal login account).
// A CrmContact may have an attached `Customer` once portal access is granted,
// but most CrmContacts never use the customer portal — they are simply leads /
// jobsite contacts that the CRM operator wants persisted in the database
// instead of localStorage. Every field is optional after first/last name so
// new fields can be added without breaking existing rows.
model CrmContact {
  id               String    @id @default(uuid())
  accountId        String? // CrmAccount this contact belongs to (the visibility scope)
  ownerId          String? // CrmUser.id of the original creator — audit trail only
  firstName        String
  lastName         String
  email            String?
  phone            String?
  serviceAddress   String?
  billingAddress   String?
  billingDifferent Boolean   @default(false)
  city             String?
  state            String?
  zip              String?
  leadSource       String?
  salesRep         String?
  firstApptDate    String?
  tags             Json? // string[] of tags
  notes            String?
  jobStatus        String? // First Contact / Appointment / ...  mirrors pipeline stage if known
  isCompleted      Boolean   @default(false)
  // Linkage back to the customer-portal account, if one exists
  portalCustomerId String?
  archivedAt       DateTime?
  /// Deleted (owner or admin): in Settings > Deleted Records until restored (lib/deletion.ts). archivedAt is the everyday Archive.
  deletedAt DateTime?
  /// Merged into this customer (lib/customerMerge.ts): kept archived with its history; Undo merge clears it.
  mergedIntoId String?
  /// Texting consent (lib/textConsent.ts): yes | no | unknown. The app texts only a "yes".
  textConsent       String    @default("unknown")
  textConsentAt     DateTime?
  /// Who recorded it: the team member's name, or "website"
  textConsentBy     String?
  /// CrmUser.id when a team member recorded it
  textConsentById   String?
  /// verbal | website_checkbox
  textConsentSource String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  textConsents CrmTextConsent[]
  account      CrmAccount?      @relation("ContactsOfCrmAccount", fields: [accountId], references: [id])
  contactNotes CrmContactNote[]
  savedQuotes  SavedQuote[]
  savedJobs    SavedJob[]
  appointments Appointment[]

  @@index([accountId])
  @@index([deletedAt])
  @@index([ownerId])
  @@index([email])
  @@index([archivedAt])
  @@index([jobStatus])
}

// ── Customer imports (lib/customerImport.ts) ──
//
// One run of an import script that wrote (scripts/mybudgetquote-import.ts
// --apply) is one ImportBatch. It lists every record the run made (customers,
// notes, cards, possible matches) and every tag it put on a customer already
// on file, so Settings > Deleted Records > Undo import takes them all back in
// one step (logged in DeletionLog, and restorable from there).
model ImportBatch {
  id         String    @id @default(uuid())
  accountId  String
  /// mybudgetquote
  source     String
  /// What a person reads: "MyBudgetQuote import, 2,736 rows"
  label      String
  fileName   String    @default("")
  createdAt  DateTime  @default(now())
  /// Who ran it (the script's name, or a login's name)
  createdBy  String    @default("")
  /// { newCustomers, matched, cards: { stage: n }, noCard, ... }
  counts     Json      @default("{}")
  /// { contacts: [ids], notes: [ids], cards: [ids], possibleMatches: [ids], tagged: [{ id, tag, updatedAtBefore, updatedAtAfter }] }
  records    Json      @default("{}")
  undoneAt   DateTime?
  undoneById String?
  /// The DeletionLog row the undo wrote (Restore there puts the import back).
  undoLogId  String?

  @@index([accountId, source])
}

/// One row of an imported file, on the customer it went to: everything the
/// old system knew (data, as the file had it, money in cents) and the row's
/// key in that system (sourceKey: MyBudgetQuote old_tool_ids), so a second
/// run makes nothing new. undoneAt: its batch was undone (the key is free again).
model CustomerImportRow {
  id           String    @id @default(uuid())
  accountId    String
  batchId      String
  crmContactId String
  source       String
  sourceKey    String
  /// true: it went to a customer already on file (matchedBy: phone | email | phone and email)
  matched      Boolean   @default(false)
  matchedBy    String?
  /// Card made for it (pipeline card id), or null and why not in data.cardWhy
  cardId       String?
  data         Json
  createdAt    DateTime  @default(now())
  undoneAt     DateTime?

  @@index([accountId, source, sourceKey])
  @@index([crmContactId])
  @@index([batchId])
}

// ── Possible matches and merges (lib/customerMerge.ts) ──
//
// A website or phone lead always makes a new customer (never attached to one
// on file by its email or phone). A customer on file with the same email or
// phone is kept here as a possible match; the office merges with one tap or
// says "Not the same person" (kept, so it does not come back).
model CustomerPossibleMatch {
  id          String    @id @default(uuid())
  accountId   String
  /// The new customer the lead made.
  contactId   String
  /// The customer already on file.
  matchId     String
  /// email | phone | email and phone
  reason      String
  /// open | dismissed | merged
  status      String    @default("open")
  decidedAt   DateTime?
  decidedById String?
  createdAt   DateTime  @default(now())

  @@unique([contactId, matchId])
  @@index([accountId, status])
  @@index([matchId])
}

// One merge: what moved (ids per table, list and key), so Undo merge moves
// exactly those back. The kept customer's own record is never changed; the
// merged customer's details as they were are kept here.
model CustomerMerge {
  id            String    @id @default(uuid())
  accountId     String
  keptId        String
  mergedId      String
  matchRowId    String?
  mergedLabel   String
  /// The merged customer's record as it was before the merge.
  mergedDetails Json
  /// { rows: [{ model, field, ids }], items: [{ doc, ids }], kv: [{ key, ids }] }
  moved         Json
  mergedById    String?
  mergedAt      DateTime  @default(now())
  undoneAt      DateTime?
  undoneById    String?

  @@index([accountId, keptId])
  @@index([mergedId])
}

// ── CRM Contact Notes — staff notes attached to a CrmContact ──
//
// Replaces the prior localStorage-backed billingStore CustomerNote. Visible to
// every staff user in the same CrmAccount; survives device switches and
// browser clears. Notes are soft deleted via deletedAt so accidental deletes
// can be recovered from the audit log.
enum CrmContactNoteVisibility {
  internal // hidden from non-admin staff (future use)
  all_staff // visible to every staff user in the account
}

model CrmContactNote {
  id           String                   @id @default(uuid())
  crmContactId String
  accountId    String // denormalized for fast tenant scoping
  body         String
  isPinned     Boolean                  @default(false)
  visibility   CrmContactNoteVisibility @default(all_staff)
  createdBy    String // display name or user identifier
  createdById  String? // CrmUser.id of the author, when known
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  deletedAt    DateTime?

  contact CrmContact @relation(fields: [crmContactId], references: [id], onDelete: Cascade)

  @@index([crmContactId])
  @@index([accountId])
  @@index([deletedAt])
}

// ── CRM Audit Log — every CRUD op on important CRM-side entities ──
//
// Distinct from the existing AuditLog model (which is tied to the customer-
// portal Customer table). This is the staff-side / CRM-side audit log.
// Records what changed, who did it, and the before/after JSON so accidental
// changes can be precisely reversed. Hooked from the new audit() helper in
// apps/portal/src/server/lib/auditLog.ts. Emit-only by default; the Admin
// Audit Log page reads it via /api/admin/audit-log.
model CrmAuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  action     String // 'create' | 'update' | 'delete' | 'soft_delete' | 'login' | 'logout' | 'invite_sent' | 'invite_accepted' | 'role_changed' | 'settings_changed' | etc.
  entityType String // 'CrmContact' | 'Quote' | 'Job' | 'Invoice' | ...
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}

// ── Backup Log — every backup attempt (daily, pre-deploy, restore) ──
model BackupLog {
  id            String   @id @default(uuid())
  backupType    String // 'daily' | 'pre-deploy' | 'restore' | 'manual'
  filePath      String
  remoteUrl     String? // s3:// path if uploaded
  fileSizeBytes BigInt   @default(0)
  status        String // 'success' | 'failed' | 'partial'
  startedAt     DateTime
  completedAt   DateTime
  errorMessage  String?
  createdAt     DateTime @default(now())

  @@index([backupType, createdAt])
  @@index([status])
}

// ── Monitoring Snapshots — daily count of key entities ──
//
// One row per day per company-tenant. Drives the /api/health endpoint's
// `database.counts` field and the daily-anomaly alert that fires when any
// count drops by more than 5 records day-over-day.
model MonitoringSnapshot {
  id                 String   @id @default(uuid())
  snapshotDate       DateTime @unique // truncated to YYYY-MM-DD UTC
  customerCount      Int      @default(0)
  contactCount       Int      @default(0)
  quoteCount         Int      @default(0)
  jobCount           Int      @default(0)
  invoiceCount       Int      @default(0)
  paymentCount       Int      @default(0)
  documentCount      Int      @default(0)
  portalAccountCount Int      @default(0)
  createdAt          DateTime @default(now())

  @@index([snapshotDate])
}

// ── Saved Quotes — the user's saved quotes from QuoteBuilder ──
//
// Replaces the prior localStorage-backed `fencepro_quotes` blob. Distinct from
// QuoteOption (per-quote bundle option for Good/Better/Best) and from the
// stateless `/api/quotes/calculate` chatbot endpoint. Money fields are Float
// to match the existing client-side calculator chain (cents-integer migration
// is a separate cross-cutting effort, see EZBIZ_KNOWN_ISSUES.md issue #3).
enum SavedQuoteStatus {
  DRAFT
  SENT
  SOLD
  LOST
}

model SavedQuote {
  id        String  @id @default(uuid())
  accountId String // tenant scope
  ownerId   String? // CrmUser.id of original creator (audit trail)

  // Customer link (preferred) + denormalized snapshot fields so quotes survive
  // contact deletes and so public share pages don't need to join.
  crmContactId    String?
  customerName    String  @default("")
  customerPhone   String  @default("")
  customerEmail   String  @default("")
  customerAddress String  @default("")
  leadSource      String  @default("")
  salesRep        String  @default("")

  // Job spec
  fenceStyle      String  @default("")
  runs            Json // number[] of run lengths in feet
  runRails        Json? // ('auto' | '6ft' | '8ft')[] for vinyl auto-mix
  layout          Json? // { yard: YardLayout | null, runSections: number[] } (web/src/yardLayout.ts)
  corners         Int     @default(0)
  ends            Int     @default(0)
  walkGates       Int     @default(0)
  dblGates        Int     @default(0)
  tearOutSections Int     @default(0)
  tearOutGates    Int     @default(0)
  adjLaborHrs     Float   @default(0)
  hasSalesman     Boolean @default(false)
  priceAdjust     Float   @default(0)

  // Computed snapshot (frozen at save time)
  sections     Int   @default(0)
  materialCost Float @default(0)
  laborCost    Float @default(0)
  tearOutCost  Float @default(0)
  totalCOGS    Float @default(0)
  finalPrice   Float @default(0)
  gmPct        Float @default(0)
  pullSheet    Json // LineItem[] from materialCalculator
  // Per quote pricing choices (labor mode, subcontractor rate, price method,
  // manual price). Null means the quote uses Settings → Pricing as is.
  pricing      Json?
  // A fence move or repair (web/src/moveRepair.ts): the job type, what was
  // entered and the cost lines it was priced with (integer cents). Null: a new
  // fence. Internal: a customer's link only ever sees the job type.
  work         Json?

  status   SavedQuoteStatus @default(DRAFT)
  date     String           @default("") // YYYY-MM-DD legacy format
  notes    String           @default("")
  leadTemp Int              @default(0)

  // Public sharing token used by #/quote/:token and #/present/:token routes.
  // Generated server-side on first request to share the quote. Unique so the
  // link is unguessable.
  shareToken        String?   @unique
  // When the customer link stops working (set from Settings → Proposals when
  // the link is made), and when staff turned it off by hand.
  shareExpiresAt    DateTime?
  shareDisabledAt   DateTime?
  // Timestamp of the first time a customer hit the public share page; null
  // until then. Drives the "viewed" badge + automation trigger.
  firstViewedAt     DateTime?
  viewCount         Int       @default(0)
  // The last time the customer opened the link (opens are counted in viewCount).
  lastViewedAt      DateTime?
  // Customer-side acceptance — recorded by POST /api/saved-quotes/share/:token/accept
  acceptedAt        DateTime?
  acceptedBy        String? // typed name or display name from the accept form
  acceptedSignature String? // base64 data URL of the signature image, if any
  // Where it was signed from (Oct 22 2026 on): the client's IP as the server saw
  // it (req.ip, trust proxy 1: the address Tailscale Funnel received the request
  // from) and its browser. Null on acceptances before then.
  acceptedIp        String?
  acceptedUserAgent String?
  // The first time this quote was Sold or accepted. Set once, never cleared
  // (lib/everSold.ts): a sold quote stays locked even if later marked Lost.
  soldAt            DateTime?
  // Proposal sent to the customer: the options offered (priced snapshots), the
  // drawn site plan and the words shown, frozen when the quote was saved.
  proposal          Json?
  // Which proposal option the customer chose when accepting (index into proposal.options).
  chosenOption      Int?
  // A sent quote saved again at today's prices (a new version): it has to be
  // sent to the customer again. Cleared when the proposal is sent.
  needsResend       Boolean   @default(false)

  archivedAt DateTime?
  /// Deleted (owner or admin): in Settings > Deleted Records until restored (lib/deletion.ts). archivedAt is the everyday Archive.
  deletedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  account CrmAccount? @relation("QuotesOfCrmAccount", fields: [accountId], references: [id])
  contact CrmContact? @relation(fields: [crmContactId], references: [id])

  @@index([accountId])
  @@index([deletedAt])
  @@index([crmContactId])
  @@index([status])
  @@index([shareToken])
  @@index([archivedAt])
}

// ── Saved Jobs — operational job records spawned from sold quotes ──
//
// Replaces the prior localStorage-backed `fencepro_jobs` blob. Named
// SavedJob to mirror SavedQuote and avoid colliding with any future
// generic Job model (none today). Money fields are Float to match the
// existing client side calculator chain.
enum SavedJobStatus {
  staging
  scheduled
  in_progress
  completed
  invoiced
  paid
  on_hold
}

enum SavedJobMaterialsStatus {
  not_ordered
  ordered
  received
  loaded
}

enum SavedJobPaymentStatus {
  not_invoiced
  invoiced
  partial
  paid
}

model SavedJob {
  id           String  @id @default(uuid())
  accountId    String // tenant scope
  quoteId      String? // SavedQuote.id; optional for legacy / hand created jobs
  crmContactId String?

  status         SavedJobStatus  @default(staging)
  previousStatus SavedJobStatus?
  /// The Operations stage id (Settings > Operations Stages; lib/opsStages.ts). '' on a job saved before
  /// stages were kept on the job: it shows where the old board put it (opsStageModel.legacyStageOfJob).
  opsStage       String          @default("")

  // Customer snapshot
  customerName    String @default("")
  customerPhone   String @default("")
  customerEmail   String @default("")
  customerAddress String @default("")

  // Scope (snapshot from quote)
  fenceStyle      String  @default("")
  sections        Int     @default(0)
  totalFeet       Int     @default(0)
  walkGates       Int     @default(0)
  dblGates        Int     @default(0)
  tearOutSections Int     @default(0)
  hasSalesman     Boolean @default(false)

  // Geolocation (for smart scheduling)
  lat Float?
  lng Float?

  // Pricing
  quotePrice       Float @default(0)
  changeOrderTotal Float @default(0)
  contractValue    Float @default(0)
  gmPct            Float @default(0)

  // Operations — staging
  materialsStatus SavedJobMaterialsStatus @default(not_ordered)
  pullSheetPulled Boolean                 @default(false)
  /// The 811 locate, one record on the job (lib/locates.ts; edited on the job page and the crew packet):
  /// locatesDate = good to dig (start) date, locatesExpDate = when the ticket expires,
  /// locateTicket = the Sunshine 811 ticket number, locateCalledDate = the day it was called in.
  locatesDate     String?
  locatesExpDate  String?
  locateTicket    String?
  locateCalledDate String?
  locateUpdatedBy String?
  locateUpdatedAt DateTime?
  drawingComplete Boolean                 @default(false)

  // Operations — scheduling
  crewAssigned     String  @default("")
  scheduledDate    String  @default("")
  scheduledEndDate String?
  estimatedDays    Int     @default(0)

  // Operations — completion
  completedDate String?
  completedBy   String?
  actualDays    Int?

  // Payment
  invoiceNumber String?
  invoiceDate   String?
  paymentStatus SavedJobPaymentStatus @default(not_invoiced)
  amountPaid    Float                 @default(0)
  paymentDate   String?
  paymentMethod String?

  // Meta
  notes      String  @default("")
  holdReason String?
  salesRep   String  @default("")
  leadSource String  @default("")

  archivedAt DateTime?
  /// Deleted (owner or admin): in Settings > Deleted Records until restored (lib/deletion.ts). archivedAt is the everyday Archive.
  deletedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  account CrmAccount? @relation("JobsOfCrmAccount", fields: [accountId], references: [id])
  contact CrmContact? @relation(fields: [crmContactId], references: [id])
  /// Its payment schedule and the schedule's log (lib/contractBilling.ts); gone with the job only if the job row itself is removed.
  paymentSchedules PaymentSchedule[]
  billingLogs      BillingLog[]

  @@index([accountId])
  @@index([deletedAt])
  @@index([crmContactId])
  @@index([quoteId])
  @@index([status])
  @@index([archivedAt])

  /// One job per quote: a second phone marking the same quote Sold gets the existing job (Oct 18, 2026).
  @@unique([accountId, quoteId])
}

// ── Schedule Settings — account-scoped configurable work days + crews ──
//
// Singleton per CrmAccount. workDays is a JSON array of weekday integers
// (0 = Sunday … 6 = Saturday); crews is a JSON array of {id, name, color}
// objects. Kept as JSON to match the existing client side shape exactly.
model ScheduleSettings {
  id        String   @id @default(uuid())
  accountId String   @unique
  workDays  Json // number[] — defaults [1,2,3,4]
  crews     Json // {id,name,color}[]
  lat       Float? // optional weather widget centerpoint
  lng       Float?
  // Goes up by one on every save of the board (settings and jobs); a save built on an older version is refused (see lib/versioned.ts).
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account CrmAccount @relation(fields: [accountId], references: [id])
}

// ── Scheduled Grid Job — denormalized entries shown on the Schedule grid ──
//
// Distinct from SavedJob (which holds the canonical job lifecycle). Each
// row here is a particular day-and-crew assignment as it appears on the
// schedule page; can reference a staging job or a SavedJob via stagingJobId.
enum ScheduledGridJobStatus {
  Scheduled
  InProgress
  Complete
  RainDay
  RolledOver
}

model ScheduledGridJob {
  id           String                 @id @default(uuid())
  accountId    String
  stagingJobId String? // SavedJob.id when applicable
  clientName   String                 @default("")
  area         String                 @default("")
  sections     Int                    @default(0)
  fenceType    String                 @default("")
  jobPrice     Float                  @default(0)
  tearout      Boolean                @default(false)
  crewId       String                 @default("")
  date         String                 @default("") // YYYY-MM-DD
  notes        String                 @default("")
  status       ScheduledGridJobStatus @default(Scheduled)
  /// Deleted (owner or admin): in Settings > Deleted Records until restored (lib/deletion.ts). archivedAt is the everyday Archive.
  deletedAt DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  account CrmAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([deletedAt])
  @@index([date])
  @@index([crewId])
  @@index([status])
}

// ── Schedule Rain Day Log — append-only log of rain-day flags ──
model ScheduleRainDay {
  id             String   @id @default(uuid())
  accountId      String
  jobId          String // ScheduledGridJob.id at the time of flagging
  clientName     String   @default("")
  originalDate   String   @default("") // YYYY-MM-DD
  rescheduleDate String   @default("") // empty = TBD
  reason         String   @default("")
  flaggedAt      DateTime @default(now())

  account CrmAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([flaggedAt])
}

// ── Pipeline State — singleton per account holding the sales pipeline ──
//
// Replaces the prior `localStorage.fencepro_pipeline` blob. The shape
// (`{ leads: PipelineLead[], stages: Stage[] }`) is preserved so the
// existing SalesPipelineBoard kanban / list view, drag and drop, and
// stage rename UI keep working unchanged. Stored as JSON because the
// kanban consumes the whole list in memory; if normalized queries are
// ever needed, leads can be split out into their own table later.
model PipelineState {
  id        String   @id @default(uuid())
  accountId String   @unique
  leads     Json // PipelineLead[]
  stages    Json // Stage[] (id, name, color, etc.)
  /// Archived cards (Archive on the card or its customer): off the board, kept for search and reports; Unarchive puts them back in leads.
  archivedLeads Json @default("[]")
  // Goes up by one on every save; a save built on an older version is refused (see lib/versioned.ts).
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account CrmAccount @relation(fields: [accountId], references: [id])
}

// ── Inventory State — singleton per account ──
//
// Replaces the prior `localStorage.fencepro_inventory` blob plus the
// associated bundles, locations, stock levels, and transaction log. Stored
// as a single JSON document because the inventory page consumes the full
// catalog in memory; if transaction volume becomes a problem the audit log
// can be split into its own table later.
model InventoryState {
  id           String   @id @default(uuid())
  accountId    String   @unique
  items        Json // InventoryItem[]
  bundles      Json // Bundle[]
  locations    Json // InventoryLocation[]
  stockLevels  Json // StockLevel[]
  transactions Json // InventoryTransaction[]
  // Material kits per style that Jonathan has saved (see web materialKits.ts); styles without one use the built in kits.
  kits         Json     @default("[]")
  // Goes up by one on every save; a save built on an older version is refused (see lib/versioned.ts).
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account CrmAccount @relation(fields: [accountId], references: [id])
}

// ── Vendor State — singleton per account holding AP-side vendor data ──
//
// Replaces the prior fencepro_vendors / fencepro_vendor_bills /
// fencepro_vendor_payments localStorage trio. Note: normalized
// VendorContact / VendorBill / VendorPayment models also exist on this
// schema (added in earlier rebrand work) but are not yet wired into the
// frontend. Phase 7 takes the simpler JSON-blob route to match the
// existing client; a follow up phase can migrate to those normalized
// models if and when fine-grained queries are needed.
model VendorState {
  id        String   @id @default(uuid())
  accountId String   @unique
  vendors   Json // VendorContact[]
  bills     Json // VendorBill[]
  payments  Json // VendorPayment[]
  // Goes up by one on every save; a save built on an older version is refused (see lib/versioned.ts).
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account CrmAccount @relation(fields: [accountId], references: [id])
}

// ── Business State — singleton per account holding Phase 8 + 9 config ──
//
// One blob covering bundles + quote options + contract sections + job
// checklists + default milestones (Phase 8) and the Phase 9 finance and
// settings stores (P&L manual entries, balance sheet entries, cash flow
// manual lines, automations, email templates, settings, company config,
// budget). Each sub-field is JSON. Fields are added incrementally per
// phase; missing fields default to empty arrays / objects on the client.
model BusinessState {
  id                String   @id @default(uuid())
  accountId         String   @unique
  // Goes up by one on every save; a save built on an older version is refused (see lib/versioned.ts).
  version           Int      @default(1)
  // Phase 8
  bundles           Json     @default("[]") // QuoteBundle[]
  quoteOptions      Json     @default("[]") // QuoteOption[]
  contractSections  Json     @default("[]") // ContractSection[]
  jobChecklists     Json     @default("{}") // Record<jobId, ChecklistItem[]>
  defaultMilestones Json     @default("[]") // string[]
  // Phase 9
  plEntries         Json     @default("[]") // PlManualEntry[]
  balanceSheet      Json     @default("[]") // BalanceSheetEntry[]
  cashFlowManual    Json     @default("[]") // CashFlowManualLine[]
  automations       Json     @default("[]") // Automation[]
  emailTemplates    Json     @default("{}") // Record<key, EmailTemplate>
  settings          Json     @default("{}") // catch all UI settings
  config            Json     @default("{}") // company info, fence styles, pricing, etc.
  budget            Json     @default("{}") // BudgetState
  pendingOrders     Json     @default("[]") // PendingOrder[] (materials reserved on sold quotes)
  purchaseOrders    Json     @default("[]") // PurchaseOrder[] (drafted/sent POs to vendors)
  invoices          Json     @default("[]") // Invoice[] (customer invoices, AR side)
  payments          Json     @default("[]") // Payment[] (customer payments)
  statements        Json     @default("[]") // Statement[] (rolled-up customer statements)
  pullSheets        Json     @default("[]") // CustomerPullSheet[] (per-customer pull sheet snapshots)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  account CrmAccount @relation(fields: [accountId], references: [id])
}

// ── Account key/value store ──
// Small pieces of company data that used to live only in one browser's
// localStorage: job costing actuals, change orders, operations stage setup,
// site plans, customer file lists, suppliers, the customer activity feed,
// import templates. One row per (company, key); the value is the same JSON
// the browser used to keep, so every device sees the same data.
model AccountKeyValue {
  accountId String
  key       String
  value     Json
  // Goes up by one on every save; a save built on an older version is refused (see lib/versioned.ts).
  version   Int      @default(1)
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@id([accountId, key])
}

// ── Intake leads ──
// A lead that arrived from outside the CRM: a quote completed on the website
// (EZ Quote widget) or a call handled by the Retell phone agent. The server
// creates the customer contact and a note right away; this row is the queue
// the CRM reads to add the lead to the sales pipeline, and it keeps the full
// original payload (drawn fence line, transcript, answers) for reference.
model IntakeLead {
  id           String    @id @default(uuid())
  accountId    String
  source       String // 'ez_quote' | 'retell'
  sourceRef    String // website quote id or Retell call id (dedupes retries)
  crmContactId String?
  name         String    @default("")
  phone        String    @default("")
  email        String    @default("")
  address      String    @default("")
  fenceType    String    @default("")
  summary      String    @default("")
  estimate     Float?
  callbackAt   String?
  payload      Json
  status       String    @default("new") // new | imported
  createdAt    DateTime  @default(now())
  importedAt   DateTime?
  /// Deleted (owner or admin): in Settings > Deleted Records until restored (lib/deletion.ts). archivedAt is the everyday Archive.
  deletedAt DateTime?

  @@unique([source, sourceRef])
  @@index([accountId, status])
  @@index([deletedAt])
}

// ── Website quote drafts (EZ Budget, /p/quote) ──
// The customer's drawing while they work, so leaving and coming back on the
// same phone picks up where they were. Keyed by a random id (an httpOnly
// cookie and the page address carry it). Holds the property address, the
// drawing and the style picked; never a name, phone or email (those go
// straight into the lead). Removed 30 days after it was last touched.
model WidgetDraft {
  id          String    @id
  accountId   String?
  data        Json
  /// The quote made from it, once sent (the same draft never makes two).
  quoteId     String?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expiresAt   DateTime

  @@index([expiresAt])
}

// ── Style photos for proposals (one per fence style, set in Settings) ──
// ── Good, Better, Best: one tier set per fence category (Settings → Good Better Best) ──
model ProposalTierSet {
  id        String   @id @default(uuid())
  accountId String
  /// The fence style category it is for (Vinyl, Chainlink, Aluminum, ...)
  category  String
  /// Up to 3 tiers: [{ key, name, install, width, color, style?, priceAdjustPct?, text }] (web/src/tiers.ts TierSpec)
  tiers     Json
  /// The tier key shown "Most popular", if any
  popular   String?
  sortOrder Int      @default(0)
  /// The starting set the server made this from (its category key), if any
  starter   String?
  /// Goes up by one on every save; a save built on an older version is refused
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One set per category per company
  @@unique([accountId, category])
}

model StylePhoto {
  id        String   @id @default(uuid())
  accountId String
  styleName String
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, styleName])
}

// ── Voice clips: recorded on a phone when live voice could not work, ──
// transcribed on this Mac with whisper.cpp, deleted after 30 days.
model VoiceClip {
  id         String    @id @default(uuid())
  accountId  String
  userId     String?
  // The quote's id: saved, or still being written (the builder's own id).
  quoteKey   String
  // The side the clip is for, when it was recorded from that side's footage.
  hint       String?
  mime       String
  path       String
  bytes      Int       @default(0)
  // waiting → transcribing → done | failed
  status     String    @default("waiting")
  transcript String?
  error      String?
  appliedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([accountId, quoteKey])
  @@index([status])
  @@index([createdAt])
}

// What a phone's browser can do for voice (Settings → Voice → Voice check).
model VoiceCheck {
  id        String   @id @default(uuid())
  accountId String
  userId    String?
  userAgent String
  results   Json
  createdAt DateTime @default(now())

  @@index([accountId])
}

// ── Photos and video on quotes, jobs and customers (Stage 6) ──
// Files live on this Mac under UPLOAD_DIR/media. The original is always kept;
// a marked up copy and, for video, a smaller copy for viewing sit beside it.
model MediaItem {
  id          String    @id @default(uuid())
  accountId   String
  // Made on the phone, so an upload that is sent twice makes one item.
  clientId    String    @unique
  kind        String // photo | video
  mime        String
  path        String
  bytes       Int       @default(0)
  markupPath  String?
  previewPath String? // smaller video for viewing (ffmpeg)
  thumbPath   String?
  width       Int?
  height      Int?
  durationMs  Int?
  quoteKey    String?
  jobId       String?
  customerId  String?
  takenBy     String?
  takenById   String?
  takenAt     DateTime
  lat         Float?
  lng         Float?
  accuracyM   Float?
  // Compass direction the phone faced, degrees from north.
  heading     Float?
  caption     String    @default("")
  category    String    @default("Site walk")
  // internal | crew | customer
  visibility  String    @default("internal")
  // Where it was taken on the site plan: { x, y } in plan feet, and the
  // direction it faced on the plan (degrees, 0 = up the page) when known.
  pin         Json?
  // processing | ready | failed
  status      String    @default("processing")
  // Crew uploads from the install packet land as Internal until marked.
  source      String    @default("staff")
  /// Made smaller after its job was Complete long enough (lib/mediaShrink.ts).
  shrunkAt    DateTime?
  /// A warranty or service request's photos (ServiceTicket): from the customer's link or portal, Internal.
  serviceTicketId String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([accountId, quoteKey])
  @@index([accountId, jobId])
  @@index([accountId, customerId])
  @@index([serviceTicketId])
}

// A resumable upload in progress: bytes arrive in chunks, so a big video
// that loses signal carries on where it stopped.
model MediaUpload {
  clientId  String   @id
  accountId String
  userId    String?
  size      Int
  received  Int      @default(0)
  path      String
  meta      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Install packet for the crew: one private link per job (Stage 7) ──
model InstallPacket {
  id           String    @id @default(uuid())
  accountId    String
  jobId        String    @unique
  token        String    @unique
  // What the crew sees about the fence, drawn by the app when sent (plan,
  // runs with spacing, counts, gates, pull sheet quantities, notes). Never
  // prices, margins or sub pay.
  snapshot     Json
  disabledAt   DateTime?
  // Filled in by the crew on the packet.
  locateTicket String?
  locateDate   String?
  sentAt       DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Records Jonathan has agreed to delete on a date (e.g. duplicates merged
// away, kept for 30 days first). The dashboard reminds him the day before;
// "Keep them" cancels. Run by lib/scheduledDeletions.ts.
model ScheduledDeletion {
  id        String    @id @default(uuid())
  accountId String
  /**
   * In plain words, for the reminder.
   */
  what      String
  /**
   * Only 'CrmContact' so far.
   */
  model     String
  recordIds Json // string[]
  /**
   * Names shown in the reminder, same order as recordIds.
   */
  labels    Json      @default("[]")
  remindOn  String // YYYY-MM-DD, Ocala time
  deleteOn  String // YYYY-MM-DD, Ocala time
  status    String    @default("scheduled") // scheduled | done | cancelled
  result    String?
  doneAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([accountId, status])
}

// ── Automations: rules, and a durable queue (Oct 18, 2026) ──
// Every trigger is saved as an AutomationEvent before anything runs; each rule
// it matches becomes one AutomationRun (unique per rule and event, so it can
// never run twice); steps run from the queue, survive restarts and retry.

model AutomationRule {
  id         String   @id @default(uuid())
  accountId  String
  name       String
  /// sales (the pipeline cards) or ops (Operations jobs)
  board      String   @default("sales")
  enabled    Boolean  @default(false)
  /// { type, stage?, days?, dateField?, offsetDays?, event? }
  trigger    Json
  /// [{ field, op, value }]
  conditions Json?
  /// [{ type, config, waitMinutes? }]
  steps      Json
  /// The starter rule this came from, if any
  starter    String?
  createdBy  String?
  /// When it was last switched on: time triggers only catch up on what fell due after this
  enabledAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([accountId, enabled])
  /// One of each starter rule per company (user-made rules have no starter; Postgres allows many NULLs).
  @@unique([accountId, starter])
}

model AutomationEvent {
  id          String    @id @default(uuid())
  accountId   String
  /// card_entered, card_left, proposal_accepted, walkthrough_signed, punch_list_cleared, payment_received, photo_uploaded, time
  type        String
  board       String?
  /// card, job, quote, customer, walkthrough
  entityKind  String
  entityId    String
  data        Json?
  /// One event per real happening: saving the same one twice is a no-op
  dedupeKey   String
  occurredAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([accountId, dedupeKey])
  @@index([processedAt])
  @@index([entityKind, entityId])
}

model AutomationRun {
  id         String   @id @default(uuid())
  accountId  String
  ruleId     String
  eventId    String
  entityKind String
  entityId   String
  /// queued, running, waiting, succeeded, failed, skipped, dry_run
  status     String   @default("queued")
  stepIndex  Int      @default(0)
  nextRunAt  DateTime @default(now())
  attempts   Int      @default(0)
  lastError  String?
  /// [{ at, step, result, detail }]
  log        Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([ruleId, eventId])
  @@index([status, nextRunAt])
  @@index([entityKind, entityId])
}

model Permit {
  id               String    @id @default(uuid())
  accountId        String
  jobId            String    @unique
  /// not_needed, needed, applied, approved, inspection_scheduled, passed
  status           String    @default("needed")
  permitNumber     String    @default("")
  county           String    @default("Marion")
  parcelId         String    @default("")
  appliedAt        String    @default("")
  approvedAt       String    @default("")
  inspectionAt     String    @default("")
  passedAt         String    @default("")
  notes            String    @default("")
  updatedBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([accountId, status])
}

/// One open of a customer's proposal link (/p/<link>), recorded by the page's
/// own script (no script, no row: link previews and prefetch never count).
/// See lib/proposalViews.ts. Staff opens are kept but marked and never counted.
model ProposalView {
  id               String   @id @default(uuid())
  accountId        String
  quoteId          String
  /// The pipeline card of the quote's customer when it was opened.
  cardId           String?
  crmContactId     String?
  startedAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  /// Time the page was on screen (ms, capped).
  activeMs         Int      @default(0)
  /// Time each option was the one most in view: { "<option index>": ms }.
  optionMs         Json     @default("{}")
  reachedSignature Boolean  @default(false)
  signed           Boolean  @default(false)
  staff            Boolean  @default(false)
  staffUserId      String?
  /// How staff was told apart: bearer, preview (the app's link), device (same device as a staff sign in).
  staffHow         String?
  userAgent        String   @default("")
  /// iPhone, iPad, Android or Computer.
  device           String   @default("")
  /// A keyed hash of the address (never the address itself), to merge reloads and limit abuse.
  ipHash           String?
  /// first | reopen: the push this open earned (sent once per key, AutomationEffect).
  pushTrigger      String?
  pushKey          String?

  @@index([quoteId, startedAt])
  @@index([accountId, startedAt])
  @@index([cardId])
}

/// A phone or browser that gets push notifications (free web push).
model PushSubscription {
  id        String   @id @default(uuid())
  accountId String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([accountId, userId])
}

/// A stage a card or job cannot be moved into until its requirements are met.
model StageRule {
  id           String   @id @default(uuid())
  accountId    String
  /// sales or ops
  board        String   @default("sales")
  stage        String
  /// [{ type: 'permit_approved' | 'walkthrough_signed' | 'has_install_date' | 'has_price' | 'has_email' | 'materials_ordered' | 'paid_in_full' }]
  requirements Json     @default("[]")
  enabled      Boolean  @default(false)
  starter      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([accountId, board, stage])
  /// One of each starter stage rule per company.
  @@unique([accountId, starter])
}

// ── Final walkthrough (Oct 18, 2026): one per job, checklist + required photos
// + two signatures, then a Certificate of Completion. Made on the phone with
// its own id (a repeat makes one); see routes/walkthroughs.ts.
model Walkthrough {
  id                String    @id @default(uuid())
  accountId         String
  /// One walkthrough per job: starting it again returns this one.
  jobId             String    @unique
  /// vinyl | chain_link | aluminum (from the job's fence style)
  category          String    @default("vinyl")
  /// open | completed
  status            String    @default("open")
  /// [{ id, label, result: pass|fix|null, note, photoClientId, punchId }]
  items             Json      @default("[]")
  /// Required photos: [{ key, label, kind: side|gate|wide, clientId }]
  photos            Json      @default("[]")
  /// { name, role, signedAt, lat, lng, accuracyM, image, via }
  homeownerSig      Json?
  repSig            Json?
  /// Both signatures in.
  signedAt          DateTime?
  /// The homeowner's link (/p/w/<token>): 30 days, can be turned off, read only once signed.
  shareToken        String?   @unique
  shareExpiresAt    DateTime?
  shareDisabledAt   DateTime?
  completedAt       DateTime?
  completedBy       String?
  /// The Certificate of Completion PDF, and its copy in the customer portal (PortalFile).
  certificatePath   String?
  certificateFileId String?
  startedBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([accountId, status])
}

/// A Needs fixing item: open until fixed and re-photographed.
model WalkthroughPunchItem {
  id               String    @id @default(uuid())
  accountId        String
  walkthroughId    String
  jobId            String
  /// The checklist item it came from.
  itemId           String
  label            String
  note             String    @default("")
  photoClientId    String?
  /// open | fixed
  status           String    @default("open")
  fixPhotoClientId String?
  fixNote          String    @default("")
  fixedAt          DateTime?
  fixedBy          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([walkthroughId])
  @@index([accountId, jobId])
}

/// What one automation step did, keyed by run and step: a step whose side
/// effect is already here is never done twice (the worker stopped after the
/// task was made but before it noted the step done).
model AutomationEffect {
  /// "<runId>:<stepIndex>"
  key       String   @id
  runId     String
  /// sending (started, outcome unknown), done
  status    String   @default("done")
  result    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([runId])
}

/// "Send feedback" from inside the app: what was on screen (a screenshot),
/// what the person wrote, and where they were. The id is chosen on the phone,
/// so a send repeated by the save queue is one row.
model Feedback {
  id             String    @id
  accountId      String
  userId         String
  userName       String    @default("")
  role           String    @default("")
  /// Page address: path and query (/customers/abc?tab=notes)
  path           String    @default("")
  /// "390x844 @3x"
  screen         String    @default("")
  userAgent      String    @default("")
  /// The app file the phone was running (/assets/index-<hash>.js)
  appFile        String    @default("")
  text           String    @default("")
  /// Screenshot under UPLOAD_DIR (feedback/<accountId>/<id>.jpg), null when none
  screenshotPath String?
  /// Page errors seen since the app was opened: [{ at, message }]
  errors         Json      @default("[]")
  /// new | seen | done
  status         String    @default("new")
  statusAt       DateTime?
  statusBy       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([accountId, createdAt])
  @@index([accountId, status])
}

// ── Follow ups (docs: lib/followUps.ts) ──

/// One call, text or other touch with a customer and how it went. The id is
/// chosen on the phone, so an answer sent again by the save queue is one row.
model CallLog {
  id             String   @id
  accountId      String
  /// The pipeline card it was about (a card lives in PipelineState.leads)
  cardId         String?
  crmContactId   String?
  /// Who made the call or sent the text
  userId         String
  userName       String   @default("")
  /// call | text | other
  channel        String   @default("call")
  /// no_answer | voicemail | deciding | not_now | booked | signed | lost
  outcome        String
  /// price | competitor | not_needed | other (outcome lost only)
  lostReason     String?
  note           String   @default("")
  /// The card's stage when it was logged
  stage          String   @default("")
  /// When it happened (the phone's clock)
  at             DateTime @default(now())
  /// The follow up this answered (YYYY-MM-DD), if one was set: on time or late
  dueOn          String?
  /// The next follow up this answer set (YYYY-MM-DD), null when it stopped them
  nextFollowUpOn String?
  createdAt      DateTime @default(now())

  @@index([accountId, cardId])
  @@index([accountId, crmContactId])
  @@index([accountId, userId, at])
}

/// Where a pipeline card is in its follow ups: the next one due and the step
/// of its stage's schedule (Settings > Follow ups). One row per card.
model CardFollowUp {
  accountId     String
  cardId        String
  /// The stage the steps run for; a card in another stage starts that stage's steps
  stage         String
  /// YYYY-MM-DD the steps count from (the day the card entered the stage)
  stageSince    String
  /// The next step of the stage's schedule still to do
  stepIndex     Int       @default(0)
  /// YYYY-MM-DD of the next follow up; null: none set
  dueOn         String?
  /// call | text | decide ("Going cold, keep or close?")
  dueKind       String    @default("call")
  /// steps | answer | manual | first
  setBy         String    @default("steps")
  /// signed | lost when the steps stopped
  stoppedReason String?
  /// Who it belongs to when the card has no salesman on it
  ownerUserId   String?
  lastOutcome   String?
  lastContactAt DateTime?
  touches       Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@id([accountId, cardId])
  @@index([accountId, dueOn])
}

/// Settings > Follow ups: the steps per stage and the text templates.
model FollowUpSettings {
  accountId String   @id
  /// { "<stage>": [{ day, kind }] }
  steps     Json
  /// [{ id, name, body }]
  templates Json
  version   Int      @default(1)
  updatedBy String?
  updatedAt DateTime @updatedAt
}

/// A call or text just started from the app (tel: or sms: link): when the
/// person comes back, "How'd it go?" is asked. Kept on the server so a phone
/// that reloaded the app while in the call still asks. One per person.
model PendingTouch {
  userId       String   @id
  accountId    String
  cardId       String
  crmContactId String?
  channel      String   @default("call")
  name         String   @default("")
  startedAt    DateTime @default(now())
}

/// A change order on a signed quote (lib/changeOrders.ts, Oct 2026): a signed
/// quote is locked (lib/quoteLock.ts), so added or removed fence, gates or a
/// style change go here. Lines in integer cents; approved ones add to the
/// job's contract value. Saved whole with a version (lib/versioned.ts).
model ChangeOrder {
  id         String    @id @default(uuid())
  accountId  String
  quoteId    String
  /// The change order's number on its quote: 1, 2, 3 ...
  number     Int       @default(1)
  /// draft | sent | approved | void
  status     String    @default("draft")
  reason     String    @default("")
  /// [{ id, description, amountCents }] (a credit is negative)
  lines      Json      @default("[]")
  totalCents Int       @default(0)
  /// What it changes in the work, from the quote builder:
  /// { footageFt, walkGates, dblGates, sections, fromStyle, toStyle } (differences). Null: typed by hand.
  scope      Json?
  createdBy  String?
  sentAt     DateTime?
  approvedAt DateTime?
  approvedBy String?
  voidedAt   DateTime?
  /// The customer's link (/p/co/<token>), made when the office asks for it: 32
  /// random bytes, so it is unique without a unique index (adding one to an
  /// existing table stops the plain db push in deploy/mac/update.sh).
  shareToken      String?
  /// Signed by the customer (the portal or the link): typed name, drawn signature (PNG data URL), when, from where.
  signedBy        String?
  signature       String?
  signedAt        DateTime?
  signedIp        String?
  signedUserAgent String?
  /// portal | link | in_person
  signedVia       String?
  /// The work after this change, from the yard drawing, priced on the server
  /// (lib/changeOrderWork.ts): the quote's fields as they become (style, runs,
  /// layout, gates, sections, pull sheet with costs, costs) and the inputs it
  /// was priced from. Null: typed lines only (the work as before).
  work           Json?
  /// What the change does to the quoted cost, in cents (owner and office only):
  /// { materialCents, laborCents, tearOutCents, totalCents }. Null: not known (typed lines).
  costDelta      Json?
  /// The contract's warranty before and after, when the change switches it
  /// (no dig <-> dig set): { id, name, text, term, years }. Null: unchanged.
  warrantyBefore Json?
  warrantyAfter  Json?
  /// Approved verbally by the owner or office: who, when and why. It counts as
  /// approved for the job; the customer's copy stays "not signed by you yet".
  verbalBy       String?
  verbalAt       DateTime?
  verbalReason   String?
  /// The contract revision it made when approved (rev 1 is the contract as signed).
  contractRev    Int?
  version    Int       @default(1)
  /// Deleted (owner or admin): in Settings > Deleted Records until restored (lib/deletion.ts). archivedAt is the everyday Archive.
  deletedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([accountId, quoteId, number])
  @@index([accountId, quoteId])
  @@index([deletedAt])
  @@index([shareToken])
}

/// A signed record (Oct 22 2026): the PDF of a contract or change order made
/// the moment it was signed (or later by scripts/signed-contracts-backfill.ts
/// from the frozen proposal and the stored signature), kept in the upload
/// folder at `fileKey` and never made again (lib/signedDocuments.ts). Shown in
/// Documents on the customer page, the quote and the job, and to the customer
/// in the portal through its PortalFile. `sourceKey` ("contract:<quoteId>",
/// "change-order:<changeOrderId>") is unique: a repeat accept or a retry never
/// makes two.
model SignedDocument {
  id              String   @id @default(uuid())
  accountId       String
  sourceKey       String   @unique
  /// contract | change_order
  kind            String
  quoteId         String
  changeOrderId   String?
  /// The job the quote became, when there was one (a job made later is found by its quote).
  jobId           String?
  /// The customer's copy in their files and portal (null while the quote has no customer).
  portalFileId    String?
  fileKey         String
  fileSizeBytes   Int
  /// SHA-256 of the PDF as it was stored.
  sha256          String
  signedAt        DateTime
  signedBy        String
  signedIp        String?
  signedUserAgent String?
  /// signing | backfill
  madeBy          String   @default("signing")
  createdAt       DateTime @default(now())

  @@index([accountId, quoteId])
  @@index([jobId])
  @@index([portalFileId])
}

/// Job costing, the "Quoted cost": what a sold quote was priced at, frozen the
/// moment it was signed (lib/jobCosting.ts). Integer cents. One per quote.
/// Quotes signed before job costing went live have none (shown "No takeoff").
model JobQuotedCost {
  id            String   @id @default(uuid())
  accountId     String
  quoteId       String
  /// proposal (the customer's link) | share (the old quote link) | app (sold in the app)
  signedVia     String   @default("app")
  signedAt      DateTime @default(now())
  fenceStyle    String   @default("")
  salesRep      String   @default("")
  /// new | move | repair
  jobType       String   @default("new")
  sections      Int      @default(0)
  footage       Int      @default(0)
  priceCents    Int      @default(0)
  materialCents Int      @default(0)
  laborCents    Int      @default(0)
  tearOutCents  Int      @default(0)
  totalCents    Int      @default(0)
  /// The pull sheet as priced: [{ key, part, inventoryItemId, qty, unitCostCents, totalCostCents }]
  lines         Json     @default("[]")
  /// How labor was priced: { mode: sub|crew|flat, subUnit, subUnits, subRateCostCents, hourlyCostCents }
  labor         Json     @default("{}")
  createdAt     DateTime @default(now())

  @@unique([accountId, quoteId])
}

/// Job costing, the final quantity takeoff after install: the pull sheet line
/// by line (used, back to the shop, back to the vendor), extras, actual labor.
/// draft -> submitted (crew or office) -> approved (owner or office). The
/// actual cost is frozen in `actualCost` when approved. The crew's phone never
/// receives a cost (lib/costRedact.ts and routes/job-costing.ts).
model JobTakeoff {
  id          String    @id
  accountId   String
  jobId       String    @unique
  quoteId     String?
  /// draft | submitted | approved
  status      String    @default("draft")
  /// YYYY-MM-DD: landed costs are taken on this day.
  installDate String    @default("")
  /// [{ id, key, part, inventoryItemId, plannedQty, usedQty, shopReturnQty, vendorReturnQty, extra, reason, note, photoClientId }]
  lines       Json      @default("[]")
  /// { mode: sub|crew, subUnit, subUnits, crew: [{ id, name, hours }] }
  labor       Json      @default("{}")
  note        String    @default("")
  startedBy   String?
  submittedAt DateTime?
  submittedBy String?
  approvedAt  DateTime?
  approvedBy  String?
  /// Frozen at approval (owner and office only): lines with landed costs, labor, totals in cents.
  actualCost  Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([accountId, status])
}

// ── Vendor invoices: uploads that update Inventory prices (lib/vendorInvoices.ts) ──
//
// A vendor invoice (one or more files: PDFs or photos of the pages) is read on
// the Mac, checked (lines + tax + freight + fees = total), matched to
// Inventory items, and its landed costs applied. Owner and office only.

model VendorInvoice {
  id             String    @id @default(uuid())
  accountId      String
  // receiving | reading | needs_review | needs_match | applied | refused | undone | failed
  // | quote (a vendor quotation: saved, never applied) | replaced (an older revision of a quote)
  status         String    @default("receiving")
  // invoice | quote. A quote changes no price until someone taps "We ordered this" (ordered).
  docType        String    @default("invoice")
  ordered        Boolean   @default(false)
  orderedAt      DateTime?
  orderedBy      String?
  // A newer revision of the same quote (same vendor and number) replaced this one.
  replacedById   String?
  // Orders revisions of one quote: the vendor's document id from the file name ("...-1429376.pdf"), when there is one.
  revision       String    @default("")
  // A tax row was printed. Without one, estimated tax (estTaxBp of the lines) is
  // added to the landed costs, unless someone says "no tax is right" (taxOk).
  taxFound       Boolean   @default(true)
  taxOk          Boolean   @default(false)
  taxRate        String    @default("")
  // The estimated tax rate this document was priced with, in basis points (722 = 7.22%), and its amount.
  estTaxBp       Int?
  estTaxCents    Int       @default(0)
  // Rows left out on purpose (*Fab notes, separators, $0.00 lines): [{ page, row, text, why }]
  skipped        Json      @default("[]")
  // The phone's id for the upload, so sending it twice makes one invoice.
  batchId        String
  pageCount      Int       @default(1)
  // The vendor in Vendors (VendorState.vendors[].id) once known.
  vendorId       String?
  vendorName     String    @default("")
  invoiceNumber  String    @default("")
  // invoiceNumber with spaces, "INV", "#" and leading zeros taken out: what duplicates are found by.
  invoiceKey     String    @default("")
  // YYYY-MM-DD
  invoiceDate    String    @default("")
  subtotalCents  Int?
  taxCents       Int       @default(0)
  freightCents   Int       @default(0)
  // Other fees and discounts: [{ label, cents }]
  fees           Json      @default("[]")
  feesCents      Int       @default(0)
  totalCents     Int?
  // Optional: only for a job lot order.
  jobId          String?
  jobName        String?
  // The bill made for it in Vendors (VendorState.bills[].id).
  billId         String?
  // vision | tesseract | pdf-text
  engine         String    @default("")
  readMs         Int       @default(0)
  // The pages as read: [{ page, image, source, rows: [{ i, text, box, conf }] }]
  pages          Json      @default("[]")
  // What stops it: header problems and the total check.
  problems       Json      @default("[]")
  // Set when refused as a duplicate: the invoice it repeats.
  duplicateOfId  String?
  message        String    @default("")
  uploadedById   String?
  uploadedBy     String    @default("")
  appliedAt      DateTime?
  undoneAt       DateTime?
  undoneBy       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  files VendorInvoiceFile[]
  lines VendorInvoiceLine[]

  @@unique([accountId, batchId])
  @@index([accountId, status])
  @@index([accountId, vendorId, invoiceKey])
  @@index([accountId, jobId])
}

model VendorInvoiceFile {
  id        String   @id @default(uuid())
  accountId String
  invoiceId String
  // The phone's id for this file (one upload).
  clientId  String   @unique
  // Order within the invoice (page photos are in the order taken).
  seq       Int      @default(0)
  fileName  String   @default("")
  mime      String
  bytes     Int      @default(0)
  path      String
  // The same file uploaded again is refused.
  sha256    String
  createdAt DateTime @default(now())

  invoice VendorInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([accountId, sha256])
  @@index([invoiceId])
}

model VendorInvoiceLine {
  id              String    @id @default(uuid())
  invoiceId       String
  seq             Int
  page            Int       @default(1)
  row             Int       @default(0)
  // Where it is on the page picture (fractions 0..1).
  box             Json?
  raw             String    @default("")
  itemNumber      String    @default("")
  description     String    @default("")
  qty             Float?
  unit            String    @default("EA")
  // Unit price in hundredths of a cent ($0.0425 = 425), so it is kept exactly.
  unitPriceHc     Int?
  totalCents      Int?
  conf            Float     @default(1)
  // Reader problems still open: math | unclear | no_quantity | no_price | no_amount | credit
  problems        Json      @default("[]")
  // Not a line to price (a note or a duplicate row read by mistake), set in review.
  ignored         Boolean   @default(false)
  // Fixed or confirmed by hand in review.
  edited          Boolean   @default(false)
  // item:<code> or desc:<words>: how the vendor's item is remembered.
  matchKey        String    @default("")
  inventoryItemId String?
  inventoryName   String    @default("")
  // vendorPer of the vendor's unit = invPer Inventory units.
  vendorPer       Float?
  invPer          Float?
  invQty          Float?
  extraCents      Int?
  // The part of extraCents that is estimated tax (the document printed no tax).
  estTaxCents     Int       @default(0)
  landedCents     Int?
  unitLandedCents Int?
  unitLandedExact Float?
  prevUnitCents   Int?
  changePct       Float?
  // open | needs_match | waiting_ok | applied | rejected | skipped
  state           String    @default("open")
  stateNote       String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  invoice VendorInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([inventoryItemId])
}

// A vendor's item, learned once: which Inventory item it is and how its unit converts.
model VendorItemLink {
  id              String   @id @default(uuid())
  accountId       String
  vendorId        String
  // item:<code> or desc:<words> (lib/invoiceMath.matchKey)
  key             String
  inventoryItemId String
  vendorUnit      String   @default("EA")
  vendorPer       Float    @default(1)
  invPer          Float    @default(1)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([accountId, vendorId, key])
  @@index([accountId, inventoryItemId])
}

// Every landed cost applied to an Inventory item, per vendor (job costing reads it: lib/priceHistory.ts).
model PriceHistory {
  id                 String    @id @default(uuid())
  accountId          String
  inventoryItemId    String
  vendorId           String?
  vendorName         String    @default("")
  invoiceId          String?
  lineId             String?
  // The invoice date, YYYY-MM-DD: the day this cost was paid.
  day                String
  unitLandedCents    Int
  unitLandedExact    Float?
  // What it replaced, so Undo can put it back.
  prevUnitCents      Int?
  prevPriceUpdatedAt String?
  prevPriceImported  Boolean?
  appliedById        String?
  appliedBy          String    @default("")
  // Applied after waiting for an OK.
  approved           Boolean   @default(false)
  // False when Inventory already had a newer price: kept for history (job costing) only.
  changedInventory   Boolean   @default(true)
  undoneAt           DateTime?
  // Where the cost came from: null for a vendor invoice; 'color_form' for a cost
  // typed in Settings → Price List → Vinyl Colors (lib/vinylColors.ts).
  source             String?
  createdAt          DateTime  @default(now())

  @@index([accountId, inventoryItemId, day])
  @@index([invoiceId])
}

// ── Deletion log: one row per delete, never removed ──
// What was deleted and everything that went with it (snapshot: lib/deletion.ts
// Snapshot), so Settings > Deleted Records can put it back. Archive writes no
// row here.
model DeletionLog {
  id               String    @id @default(uuid())
  accountId        String
  /// customer, quote, job, card, login, inventory_item, vendor, note, photo, schedule_entry, rain_day
  entityType       String
  entityId         String
  /// What a person reads: the customer's name, "Quote for Smith, ...", "Job for Smith, ..."
  entityLabel      String    @default("")
  snapshot         Json
  /// Every id the snapshot holds (the record and its children), so a waiting change from an older screen cannot put one back.
  ids              String[]  @default([])
  deletedByUserId  String?
  deletedAt        DateTime  @default(now())
  reason           String?
  restoredAt       DateTime?
  restoredByUserId String?
  /// { restored, skipped: [{ what, why }] }
  restoreResult    Json?

  @@index([accountId, deletedAt])
  @@index([accountId, entityType])
}

/// A warranty update sent to a customer (Oct 2026, lib/warrantyUpdates.ts): a new
/// link (/p/wu/<token>) that shows the warranty Settings give their option now,
/// with the price and the signed contract unchanged. The quote itself is never
/// changed: the warranties are a snapshot on this row.
///   signed:   a sold or accepted quote; the customer types their name to
///             acknowledge it, then the job and its Warranty Certificate use it.
///   proposal: a sent, unsigned proposal; the link is the same proposal with
///             each option's current warranty (prices identical), and the
///             original link still works as sent. Accepting on it signs the
///             proposal with these warranties.
model WarrantyUpdate {
  id                 String    @id @default(uuid())
  accountId          String
  quoteId            String
  jobId              String?
  crmContactId       String?
  /// signed | proposal
  kind               String
  /// The option it is for (signed: the accepted option; null for an unsigned proposal, which shows every option).
  optionIndex        Int?
  warrantyId         String?
  warrantyName       String    @default("")
  warrantyText       String    @default("")
  /// lifetime | years | unknown
  warrantyTerm       String    @default("")
  warrantyYears      Int?
  /// Each option's warranty now: [{ index, label, fenceStyle, finalPrice, warranty: { id, name, text, term, years }, before, changed }]
  options            Json      @default("[]")
  token              String    @unique
  createdByUserId    String?
  createdBy          String    @default("")
  createdAt          DateTime  @default(now())
  /// text | email | copy: the last way staff sent it, and when.
  sentChannel        String?
  sentAt             DateTime?
  /// Customer opens (staff opens are not counted).
  openCount          Int       @default(0)
  firstOpenedAt      DateTime?
  lastOpenedAt       DateTime?
  acknowledgedAt     DateTime?
  acknowledgedBy     String?
  /// acknowledged (typed name on a signed quote) | accepted (signed the proposal on this link)
  acknowledgedHow    String?
  /// The option acknowledged or accepted.
  acknowledgedOption Int?

  @@index([accountId, quoteId])
  @@index([jobId])
  @@index([crmContactId])
}

/// Every yes or no a customer gave to texts, oldest first (lib/textConsent.ts):
/// a yes then a no are both kept, with who recorded each and when. The
/// customer's current answer is on CrmContact.textConsent. Never edited.
model CrmTextConsent {
  id           String   @id @default(uuid())
  accountId    String
  crmContactId String
  /// yes | no
  consent      String
  /// verbal | website_checkbox
  source       String
  /// The team member's name, or "website"
  byName       String
  byUserId     String?
  /// A website answer: the exact checkbox words the customer saw
  wording      String?
  /// A website answer: where it came from, as proof of the opt in
  ip           String?
  userAgent    String?
  at           DateTime @default(now())

  contact CrmContact @relation(fields: [crmContactId], references: [id], onDelete: Cascade)

  @@index([crmContactId, at])
  @@index([accountId])
}

// ── Contract billing: payment schedules, payments, receipts (lib/contractBilling.ts) ──
//
// Made by the server from the signed contract (never typed by hand): a
// Deposit due at signing and a Final due on completion (progress invoices
// when a contract defines them). Integer cents. A payment never changes an
// invoice's amount, only what is paid and the balance; every change to an
// amount is a BillingLog row and an audit entry.

/// One per job: the signed contract amount it was made from (never edited in place).
model PaymentSchedule {
  id           String   @id @default(uuid())
  accountId    String
  jobId        String
  quoteId      String?
  crmContactId String?
  /// The signed contract amount, in cents, as signed.
  signedCents  Int
  /// The deposit percent the schedule was made with (the proposal's, else 50).
  depositPct   Float    @default(50)
  /// sold (marked Sold in the app) | accepted (the customer's link) | button (made from the job page) | adopted (hand-made Billing invoices)
  source       String   @default("sold")
  createdBy    String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  job      SavedJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  invoices ContractInvoice[]

  @@unique([accountId, jobId])
  @@index([accountId, crmContactId])
}

/// An invoice on a payment schedule. amountCents moves only by a logged edit (BillingLog).
model ContractInvoice {
  id            String    @id @default(uuid())
  accountId     String
  scheduleId    String
  jobId         String
  quoteId       String?
  crmContactId  String?
  /// deposit | progress-1 ... | final | legacy-<old id>
  key           String
  /// deposit | progress | final | other
  kind          String
  label         String
  sortOrder     Int       @default(0)
  /// The amount it was made with, never changed.
  originalCents Int
  /// The amount now (an owner's logged edit, or the Final following the contract).
  amountCents   Int
  /// The contract amount when this was made or last changed.
  contractCents Int
  /// signing | completion | date
  dueOn         String    @default("signing")
  /// YYYY-MM-DD; the Final's is the install date, empty until the job is installed.
  dueDate       String?
  /// Adopted from the hand-made Billing invoices (BusinessState.invoices).
  legacyId      String?
  legacyNumber  String?
  voidedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  schedule PaymentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, key])
  @@index([accountId, jobId])
}

/// An owner's change to the contract amount (a signed amount is never edited in place): -27 = 27 cents off.
model ContractAdjustment {
  id          String   @id @default(uuid())
  accountId   String
  jobId       String
  amountCents Int
  reason      String
  byUserId    String?
  byName      String   @default("")
  createdAt   DateTime @default(now())

  @@index([accountId, jobId])
}

/// A payment from the customer. The id is the one the phone gave it (a repeat create is the first one).
model ContractPayment {
  id             String    @id
  accountId      String
  jobId          String
  quoteId        String?
  crmContactId   String?
  amountCents    Int
  /// check | cash | zelle | card | other
  method         String
  checkNumber    String?
  reference      String?
  /// YYYY-MM-DD
  paidOn         String
  note           String    @default("")
  /// The check's photo (uploads/payments/...), staff only.
  photoKey       String?
  recordedById   String?
  recordedBy     String    @default("")
  recordedRole   String?
  /// Recorded by a Salesman: the owner or office confirms it (the receipt does not change).
  needsConfirm   Boolean   @default(false)
  confirmedAt    DateTime?
  confirmedBy    String?
  voidedAt       DateTime?
  voidedBy       String?
  voidReason     String?
  /// app | adopted
  source         String    @default("app")
  legacyId       String?
  createdAt      DateTime  @default(now())

  @@index([accountId, jobId])
  @@index([accountId, needsConfirm])
}

/// How much of a payment went to which invoice: oldest open invoice first, the rest carried to the next. Rebuilt on every change.
model PaymentApplication {
  id          String @id @default(uuid())
  accountId   String
  paymentId   String
  invoiceId   String
  amountCents Int

  @@index([paymentId])
  @@index([invoiceId])
}

/// A receipt for one payment, numbered in one company sequence. What it says is frozen in `snapshot` (cents).
model Receipt {
  id            String    @id @default(uuid())
  accountId     String
  number        Int
  paymentId     String    @unique
  jobId         String
  crmContactId  String?
  /// The customer's link /p/r/<token> (no sign in).
  token         String    @unique
  snapshot      Json
  lienRelease   Boolean   @default(false)
  portalFileId  String?
  voidedAt      DateTime?
  emailTo       String?
  /// sent | failed | not_configured
  emailStatus   String?
  emailedAt     DateTime?
  textedTo      String?
  textedAt      DateTime?
  createdAt     DateTime  @default(now())

  @@unique([accountId, number])
  @@index([accountId, jobId])
}

/// The next receipt number of a company.
model ReceiptCounter {
  accountId String @id
  next      Int    @default(1001)
}

/// Receipt numbers set aside for one phone while it had signal, so a receipt made with no signal has its real number.
model ReceiptNumberBlock {
  id        String   @id @default(uuid())
  accountId String
  userId    String
  first     Int
  last      Int
  createdAt DateTime @default(now())

  @@index([accountId, userId])
}

/// Every change to a schedule's amounts, in plain words: an amount edit, the Final following a change order or an adjustment, a void.
model BillingLog {
  id        String   @id @default(uuid())
  accountId String
  jobId     String
  invoiceId String?
  paymentId String?
  /// amount_edit | final_follows | adjustment | adopted | void | confirm | made
  kind      String
  fromCents Int?
  toCents   Int?
  text      String
  byName    String   @default("")
  byUserId  String?
  at        DateTime @default(now())

  job SavedJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([accountId, jobId])
}

// ── Warranty and service requests (lib/serviceTickets.ts, Oct 22 2026) ──
//
// A past customer calls about their fence: a ticket on the job, with the
// issue, the job's warranty as it was when the request was made, a hint from
// the warranty rules (lib/serviceTicketModel.ts), photos from the customer
// (a no login link, /p/s/<link>, or the portal), the office's covered or not
// covered decision with a reason, the service appointment that books it, and
// for covered work, what fixing it cost (ServiceWorkCost).

model ServiceTicket {
  id                String    @id @default(uuid())
  accountId         String
  jobId             String
  crmContactId      String?
  quoteId           String?
  /// leaning_post | damaged_section | gate | storm_tree | other
  issue             String
  notes             String    @default("")
  /// new | photos_requested | photos_received | scheduled | fixed | closed
  stage             String    @default("new")
  /// The job's warranty when the request was made.
  warrantyId        String?
  warrantyName      String    @default("")
  warrantyText      String    @default("")
  /// lifetime | years | unknown | none
  warrantyTerm      String    @default("none")
  warrantyYears     Int?
  installDate       String?
  warrantyEnd       String?
  /// likely_covered | likely_not_covered | needs_look, and why (serviceTicketModel.ts HINT_RULES)
  hint              String    @default("needs_look")
  hintWhy           String    @default("")
  /// covered | not_covered; null until the owner or office decide.
  decision          String?
  decisionReason    String    @default("")
  decisionBy        String?
  decisionAt        DateTime?
  /// The customer portal shows the decision and its reason only when this is on.
  decisionShared    Boolean   @default(false)
  /// The service appointment that books the visit.
  appointmentId     String?
  /// A not covered ticket's repair quote (the first repair quote for the customer after the ticket).
  repairQuoteId     String?
  /// The no login photo link, /p/s/<uploadToken>, open until uploadExpiresAt (14 days from the last "Ask for photos").
  uploadToken       String?   @unique
  uploadExpiresAt   DateTime?
  photosRequestedAt DateTime?
  photosReceivedAt  DateTime?
  scheduledAt       DateTime?
  fixedAt           DateTime?
  closedAt          DateTime?
  /// [{ at, by, kind, text }] oldest first: made, photos asked, photos in, decided, booked, fixed, closed.
  history           Json      @default("[]")
  createdBy         String    @default("")
  createdById       String?
  version           Int       @default(1)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([accountId, stage])
  @@index([jobId])
  @@index([crmContactId])
}

/// What covered warranty work cost: crew hours and materials entered when the
/// ticket is Fixed, costed like job costing (the hourly rate saved when the job
/// was signed, else Settings' rate that day; each part's landed cost on the day
/// fixed). Frozen as entered: a later rate change never rewrites it.
model ServiceWorkCost {
  id              String   @id @default(uuid())
  accountId       String
  ticketId        String   @unique
  jobId           String
  /// YYYY-MM-DD
  fixedOn         String
  /// The job's style and who installed it (SavedJob.crewAssigned), for the report.
  fenceStyle      String   @default("")
  installer       String   @default("")
  warrantyName    String   @default("")
  /// [{ name, hours }]
  crew            Json     @default("[]")
  hours           Float    @default(0)
  hourlyCostCents Int      @default(0)
  hourlySource    String   @default("")
  laborCents      Int      @default(0)
  /// [{ inventoryItemId, part, qty, unitCents, totalCents, source }]
  materials       Json     @default("[]")
  materialCents   Int      @default(0)
  totalCents      Int      @default(0)
  enteredBy       String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId, fixedOn])
}
